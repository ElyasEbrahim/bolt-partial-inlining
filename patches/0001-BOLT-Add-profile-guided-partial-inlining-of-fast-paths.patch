+RegAnalysis &PartialInlining::getRegAnalysis(BinaryContext &BC) {
+  if (!RA) {
+    CG = std::make_unique<BinaryFunctionCallGraph>(buildCallGraph(BC));
+    RA = std::make_unique<RegAnalysis>(BC, &BC.getBinaryFunctions(), CG.get());
+  }
+  return *RA;
+}
+
+PartialInlining::RejectReason
+PartialInlining::buildRegion(BinaryFunction &BF, FastRegion &Region,
+                             const DenseSet<const BinaryBasicBlock *> &Excluded,
+                             SmallVectorImpl<const BinaryBasicBlock *> &Prune) {
+  BinaryContext &BC = BF.getBinaryContext();
+  const MCPlusBuilder &MIB = *BC.MIB;
+  const unsigned NumRegs = BC.MRI->getNumRegs();
+  Region = FastRegion();
+  Prune.clear();
+  BinaryBasicBlock *Entry = &BF.front();
+
+  auto isCopyableBlock = [&](const BinaryBasicBlock &BB) {
+    if (BB.isLandingPad() || Excluded.count(&BB))
+      return false;
+    for (const MCInst &Inst : BB)
+      if (!isCopyableInstruction(BC, BF, Inst))
+        return false;
+    // A conditional branch must have both of its successors in the CFG.
+    const MCInst *Last = BB.getLastNonPseudoInstr();
+    if (Last && MIB.isConditionalBranch(*Last) && BB.succ_size() != 2)
+      return false;
+    if (Last && MIB.isReturn(*Last) && BB.succ_size() != 0)
+      return false;
+    return true;
+  };
+
+  // Step 1: blocks reachable from the entry through copyable blocks. The
+  // exploration is bounded since only short regions are of interest.
+  const unsigned ExploreLimit = 4 * opts::PartialInlineMaxBlocks + 16;
+  DenseSet<const BinaryBasicBlock *> Candidates;
+  {
+    SmallVector<BinaryBasicBlock *, 16> Worklist{Entry};
+    DenseSet<const BinaryBasicBlock *> Visited;
+    while (!Worklist.empty() && Visited.size() < ExploreLimit) {
+      BinaryBasicBlock *BB = Worklist.pop_back_val();
+      if (!Visited.insert(BB).second)
+        continue;
+      if (!isCopyableBlock(*BB))
+        continue;
+      Candidates.insert(BB);
+      for (BinaryBasicBlock *Succ : BB->successors())
+        Worklist.push_back(Succ);
+    }
+  }
+  if (!Candidates.count(Entry))
+    return RR_EntryNotSafe;
+
+  // Step 2: drop blocks that are part of a cycle within the candidate
+  // subgraph (Tarjan's SCC algorithm on the small subgraph).
+  {
+    DenseMap<const BinaryBasicBlock *, unsigned> Index, LowLink;
+    DenseSet<const BinaryBasicBlock *> OnStack, InCycle;
+    SmallVector<const BinaryBasicBlock *, 16> Stack;
+    unsigned NextIndex = 0;
+    std::function<void(const BinaryBasicBlock *)> StrongConnect =
+        [&](const BinaryBasicBlock *BB) {
+          Index[BB] = LowLink[BB] = NextIndex++;
+          Stack.push_back(BB);
+          OnStack.insert(BB);
+          for (const BinaryBasicBlock *Succ : BB->successors()) {
+            if (!Candidates.count(Succ))
+              continue;
+            if (Succ == BB)
+              InCycle.insert(BB);
+            if (!Index.count(Succ)) {
+              StrongConnect(Succ);
+              LowLink[BB] = std::min(LowLink[BB], LowLink[Succ]);
+            } else if (OnStack.count(Succ)) {
+              LowLink[BB] = std::min(LowLink[BB], Index[Succ]);
+            }
+          }
+          if (LowLink[BB] != Index[BB])
+            return;
+          SmallVector<const BinaryBasicBlock *, 4> SCC;
+          const BinaryBasicBlock *Member;
+          do {
+            Member = Stack.pop_back_val();
+            OnStack.erase(Member);
+            SCC.push_back(Member);
+          } while (Member != BB);
+          if (SCC.size() > 1)
+            InCycle.insert(SCC.begin(), SCC.end());
+        };
+    StrongConnect(Entry);
+    if (InCycle.count(Entry))
+      return RR_NoFastExit;
+    for (const BinaryBasicBlock *BB : InCycle)
+      Candidates.erase(BB);
+  }
+
+  // Step 3: keep blocks that are reachable from the entry and from which a
+  // return is reachable (both within the candidate subgraph).
+  DenseSet<const BinaryBasicBlock *> Reachable;
+  {
+    SmallVector<const BinaryBasicBlock *, 16> Worklist{Entry};
+    while (!Worklist.empty()) {
+      const BinaryBasicBlock *BB = Worklist.pop_back_val();
+      if (!Candidates.count(BB) || !Reachable.insert(BB).second)
+        continue;
+      for (const BinaryBasicBlock *Succ : BB->successors())
+        Worklist.push_back(Succ);
+    }
+  }
+  {
+    SmallVector<const BinaryBasicBlock *, 16> Worklist;
+    for (const BinaryBasicBlock *BB : Reachable) {
+      const MCInst *Last = BB->getLastNonPseudoInstr();
+      if (Last && MIB.isReturn(*Last))
+        Worklist.push_back(BB);
+    }
+    while (!Worklist.empty()) {
+      const BinaryBasicBlock *BB = Worklist.pop_back_val();
+      if (!Reachable.count(BB) || !Region.InRegion.insert(BB).second)
+        continue;
+      for (const BinaryBasicBlock *Pred : BB->predecessors())
+        Worklist.push_back(Pred);
+    }
+  }
+  if (!Region.InRegion.count(Entry))
+    return RR_NoFastExit;
+
+  // Step 4: topological order (reverse post-order from the entry).
+  {
+    SmallVector<BinaryBasicBlock *, 8> PostOrder;
+    DenseSet<const BinaryBasicBlock *> Visited;
+    std::function<void(BinaryBasicBlock *)> DFS = [&](BinaryBasicBlock *BB) {
+      Visited.insert(BB);
+      for (BinaryBasicBlock *Succ : BB->successors())
+        if (Region.InRegion.count(Succ) && !Visited.count(Succ))
+          DFS(Succ);
+      PostOrder.push_back(BB);
+    };
+    DFS(Entry);
+    Region.Blocks.assign(PostOrder.rbegin(), PostOrder.rend());
+  }
+
+  // Step 5: profile flow and fast-exit probabilities.
+  for (BinaryBasicBlock *BB : Region.Blocks)
+    Region.SuccProb[BB] = getSuccessorProbabilities(*BB);
+  // Entry flow is the number of invocations. The entry block count can be
+  // larger if the function branches back to its entry.
+  Region.Flow[Entry] = static_cast<double>(
+      BF.getKnownExecutionCount() ? BF.getKnownExecutionCount()
+                                  : Entry->getKnownExecutionCount());
+  for (BinaryBasicBlock *BB : Region.Blocks) {
+    const double Flow = Region.Flow[BB];
+    const SmallVector<double, 2> &Probs = Region.SuccProb[BB];
+    unsigned I = 0;
+    for (BinaryBasicBlock *Succ : BB->successors()) {
+      if (Region.InRegion.count(Succ))
+        Region.Flow[Succ] += Flow * Probs[I];
+      ++I;
+    }
+  }
+  for (BinaryBasicBlock *BB : llvm::reverse(Region.Blocks)) {
+    const MCInst *Last = BB->getLastNonPseudoInstr();
+    if (Last && MIB.isReturn(*Last)) {
+      Region.PFast[BB] = 1.0;
+      continue;
+    }
+    double P = 0.0;
+    const SmallVector<double, 2> &Probs = Region.SuccProb[BB];
+    unsigned I = 0;
+    for (const BinaryBasicBlock *Succ : BB->successors()) {
+      if (Region.InRegion.count(Succ))
+        P += Probs[I] * Region.PFast[Succ];
+      ++I;
+    }
+    Region.PFast[BB] = P;
+  }
+  Region.EntryFlow = Region.Flow[Entry];
+  Region.FastProb = Region.PFast[Entry];
+  Region.SlowCount = Region.EntryFlow * (1.0 - Region.FastProb);
+
+  // Step 6: drop cold blocks. They do not contribute to the fast path but
+  // add size and may introduce side effects or register hazards. The pruned
+  // blocks' incoming edges become slow exits.
+  const double MinFlow =
+      Region.EntryFlow * opts::PartialInlineMinBlockFlow / 100.0;
+  for (const BinaryBasicBlock *BB : llvm::drop_begin(Region.Blocks))
+    if (Region.Flow[BB] < MinFlow)
+      Prune.push_back(BB);
+  if (!Prune.empty())
+    return RR_ColdFastPath;
+
+  // Step 7: forward frame/dataflow analysis in topological order. A
+  // violation in a non-entry block prunes that block (its incoming edges
+  // become slow exits); a violation in the entry block rejects the callee.
+  DenseMap<const BinaryBasicBlock *, RegionState> StateIn;
+  DenseMap<const BinaryBasicBlock *, bool> HasSideEffect;
+  DenseMap<const BinaryBasicBlock *, BitVector> BlockUE, BlockDefs;
+  BitVector NeedsRename(NumRegs, false);
+  {
+    RegionState &S = StateIn[Entry];
+    S.Valid = true;
+    S.Saved = S.Dirty = S.MustDirty = S.Written = S.MustDef =
+        BitVector(NumRegs, false);
+  }
+  // Constant registers (e.g. XZR/WZR) are written and read by many
+  // instructions but carry no state.
+  // Their sub-registers (e.g. WZR_HI on AArch64) are constant as well.
+  BitVector ConstRegs(NumRegs, false);
+  for (unsigned R = 1; R < NumRegs; ++R)
+    if (BC.MRI->isConstant(R))
+      ConstRegs |= MIB.getAliases(R, /*OnlySmaller=*/true);
+  const MCPhysReg SP = MIB.getStackPointer();
+  const MCPhysReg FP = MIB.getFramePointer();
+  const BitVector &SPAliases = MIB.getAliases(SP, /*OnlySmaller=*/false);
+  const BitVector &FPAliases = MIB.getAliases(FP, /*OnlySmaller=*/false);
+  BitVector RAAliases(NumRegs, false);
+  if (BC.isAArch64())
+    RAAliases = MIB.getAliases(BC.MRI->getRARegister(), /*OnlySmaller=*/false);
+
+  auto fail = [&](const BinaryBasicBlock *BB, RejectReason R) {
+    if (BB != Entry)
+      Prune.push_back(BB);
+    return R;
+  };
+  for (BinaryBasicBlock *BB : Region.Blocks) {
+    RegionState S = StateIn[BB];
+    assert(S.Valid && "unreachable region block");
+    BitVector UE(NumRegs, false), Defs(NumRegs, false);
+    bool SideEffect = false;
+
+    for (const MCInst &Inst : *BB) {
+      if (MIB.isCFI(Inst) || MIB.isNoop(Inst)) {
+        Region.Dropped.insert(&Inst);
+        continue;
+      }
+
+      MCPlusBuilder::FrameInstrInfo FI;
+      if (MIB.analyzeFrameInstruction(Inst, FI) &&
+          (opts::PartialInlineFrameElision ||
+           FI.Kind == MCPlusBuilder::FrameInstrInfo::FIK_LandingPad)) {
+        using FIK = MCPlusBuilder::FrameInstrInfo;
+        Region.Dropped.insert(&Inst);
+        switch (FI.Kind) {
+        case FIK::FIK_None:
+          llvm_unreachable("unexpected frame instruction kind");
+        case FIK::FIK_LandingPad:
+          break;
+        case FIK::FIK_SignRA:
+          if (S.RASigned)
+            return fail(BB, RR_FrameMismatch);
+          S.RASigned = true;
+          Region.HasFrame = true;
+          break;
+        case FIK::FIK_AuthRA:
+          if (!S.RASigned)
+            return fail(BB, RR_FrameMismatch);
+          S.RASigned = false;
+          break;
+        case FIK::FIK_SPAdjust:
+          S.SPOffset += FI.SPDelta;
+          Region.HasFrame = true;
+          break;
+        case FIK::FIK_FPSetup:
+          // FP may only be modified after its entry value has been saved.
+          if (!S.Saved.test(FP))
+            return fail(BB, RR_FrameMismatch);
+          S.FPModified = true;
+          break;
+        case FIK::FIK_Save:
+          for (unsigned I = 0; I < FI.Regs.size(); ++I) {
+            const MCPhysReg Reg = FI.Regs[I];
+            const int64_t Slot = S.SPOffset + FI.Offset + I * FI.SlotSize;
+            // Only spills of entry values into the callee's own frame.
+            if (Slot + static_cast<int64_t>(FI.SlotSize) > 0 ||
+                S.Slots.count(Slot))
+              return fail(BB, RR_FrameMismatch);
+            if (MIB.getAliases(Reg, false).anyCommon(S.Written) ||
+                MIB.getAliases(Reg, false).anyCommon(SPAliases) ||
+                S.Saved.test(Reg))
+              return fail(BB, RR_FrameMismatch);
+            if (Reg == FP && S.FPModified)
+              return fail(BB, RR_FrameMismatch);
+            S.Slots[Slot] = Reg;
+            S.Saved.set(Reg);
+          }
+          S.SPOffset += FI.SPDelta;
+          Region.HasFrame = true;
+          break;
+        case FIK::FIK_Restore:
+          for (unsigned I = 0; I < FI.Regs.size(); ++I) {
+            const MCPhysReg Reg = FI.Regs[I];
+            const int64_t Slot = S.SPOffset + FI.Offset + I * FI.SlotSize;
+            auto It = S.Slots.find(Slot);
+            if (It == S.Slots.end() || It->second != Reg)
+              return fail(BB, RR_FrameMismatch);
+            S.Dirty.reset(Reg);
+            S.MustDirty.reset(Reg);
+            if (Reg == FP)
+              S.FPModified = false;
+          }
+          S.SPOffset += FI.SPDelta;
+          break;
+        }
+        continue;
+      }
+
+      if (MIB.isReturn(Inst)) {
+        // Fast exit: the frame must be fully torn down, and a signed return
+        // address must be authenticated by the return itself (RETAA/RETAB).
+        const bool AuthenticatingReturn =
+            BC.isAArch64() && MIB.isPAuthAndRet(Inst);
+        if (S.SPOffset != 0 || S.Dirty.any() || S.FPModified ||
+            S.RASigned != AuthenticatingReturn)
+          return fail(BB, RR_FrameMismatch);
+        continue;
+      }
+
+      // Regular instruction. It is copied verbatim (up to renaming), so it
+      // must not depend on the stack pointer, the frame pointer or the return
+      // address register, which differ between the caller and the callee.
+      BitVector Used(NumRegs, false), Written(NumRegs, false);
+      MIB.getUsedRegs(Inst, Used);
+      MIB.getWrittenRegs(Inst, Written);
+      Used.reset(ConstRegs);
+      Written.reset(ConstRegs);
+      BitVector Touched = Used;
+      Touched |= Written;
+      if (Touched.anyCommon(SPAliases) || Touched.anyCommon(FPAliases) ||
+          Touched.anyCommon(RAAliases))
+        return fail(BB, RR_StackAccess);
+
+      // Callee-saved registers whose entry value was spilled are temporaries
+      // for the body. All their accesses are renamed to a scratch register,
+      // so they may only be read after being written on every path. Reading
+      // their entry value is not supported.
+      for (int R = S.Saved.find_first(); R != -1; R = S.Saved.find_next(R)) {
+        const BitVector &Aliases = MIB.getAliases(R, /*OnlySmaller=*/false);
+        if (Used.anyCommon(Aliases) && !S.MustDirty.test(R))
+          return fail(BB, RR_FrameMismatch);
+        if (Written.anyCommon(Aliases)) {
+          S.Dirty.set(R);
+          S.MustDirty.set(R);
+          NeedsRename.set(R);
+        }
+      }
+
+      const MCInstrDesc &Desc = BC.MII->get(Inst.getOpcode());
+      if (MIB.mayStore(Inst) || Desc.hasUnmodeledSideEffects())
+        SideEffect = true;
+
+      // Re-execution hazard bookkeeping. Renamed registers are excluded:
+      // they become fresh scratch registers that are always written before
+      // they are read.
+      const BitVector SavedAliases = getAliasClosure(BC, S.Saved);
+      BitVector FullDefs = getFullyDefinedRegs(BC, Inst);
+      Used.reset(SavedAliases);
+      Written.reset(SavedAliases);
+      FullDefs.reset(SavedAliases);
+      FullDefs.reset(ConstRegs);
+      BitVector NotDefined = Used;
+      NotDefined.reset(S.MustDef);
+      UE |= NotDefined;
+      S.MustDef |= FullDefs;
+      Defs |= Written;
+      S.Written |= Written;
+
+      ++Region.NumCopiedInsts;
+    }
+
+    HasSideEffect[BB] = SideEffect;
+    BlockUE[BB] = UE;
+    BlockDefs[BB] = Defs;
+
+    // Propagate the state to region successors.
+    for (BinaryBasicBlock *Succ : BB->successors()) {
+      if (!Region.InRegion.count(Succ))
+        continue;
+      RegionState &SuccState = StateIn[Succ];
+      if (!SuccState.Valid) {
+        SuccState = S;
+        continue;
+      }
+      if (!SuccState.frameEquals(S))
+        return fail(Succ, RR_FrameMismatch);
+      SuccState.Dirty |= S.Dirty;
+      SuccState.MustDirty &= S.MustDirty;
+      SuccState.Written |= S.Written;
+      SuccState.MustDef &= S.MustDef;
+    }
+  }
+
+  // Step 8: slow-exit reachability (reverse topological order).
+  DenseMap<const BinaryBasicBlock *, bool> CanReachSlow;
+  for (BinaryBasicBlock *BB : llvm::reverse(Region.Blocks)) {
+    bool Slow = false;
+    for (const BinaryBasicBlock *Succ : BB->successors())
+      Slow |= !Region.InRegion.count(Succ) || CanReachSlow[Succ];
+    CanReachSlow[BB] = Slow;
+  }
+
+  // Step 9: side effects are only allowed on blocks that cannot reach a slow
+  // exit. Otherwise prune the offending block and let the caller retry.
+  for (BinaryBasicBlock *BB : Region.Blocks) {
+    if (HasSideEffect[BB] && CanReachSlow[BB]) {
+      Prune.push_back(BB);
+      return RR_SideEffect;
+    }
+  }
+
+  // Step 10: registers written on a path to a slow exit must not be read
+  // before being defined on such a path. If the conflict involves non-entry
+  // blocks, prune the coldest of them and let the caller retry.
+  {
+    BitVector SlowUE(NumRegs, false), SlowDefs(NumRegs, false);
+    for (BinaryBasicBlock *BB : Region.Blocks) {
+      if (!CanReachSlow[BB])
+        continue;
+      SlowUE |= BlockUE[BB];
+      SlowDefs |= BlockDefs[BB];
+    }
+    const BitVector SlowDefAliases = getAliasClosure(BC, SlowDefs);
+    if (SlowDefAliases.anyCommon(SlowUE)) {
+      LLVM_DEBUG({
+        BitVector Conflict = SlowDefAliases;
+        Conflict &= SlowUE;
+        dbgs() << "BOLT-DEBUG: partial inlining: " << BF
+               << ": registers read and overwritten before a slow exit:";
+        for (int R = Conflict.find_first(); R != -1; R = Conflict.find_next(R))
+          dbgs() << ' ' << BC.MRI->getName(R);
+        dbgs() << '\n';
+      });
+      const BinaryBasicBlock *Coldest = nullptr;
+      for (const BinaryBasicBlock *BB : llvm::drop_begin(Region.Blocks)) {
+        if (!CanReachSlow[BB])
+          continue;
+        const bool Involved =
+            BlockUE[BB].anyCommon(SlowDefAliases) ||
+            getAliasClosure(BC, BlockDefs[BB]).anyCommon(SlowUE);
+        if (Involved && (!Coldest || Region.Flow[BB] < Region.Flow[Coldest]))
+          Coldest = BB;
+      }
+      if (Coldest)
+        Prune.push_back(Coldest);
+      return RR_RegClobber;
+    }
+  }
+
+  // Step 11: size limits. Prune the coldest non-entry block if needed.
+  if (Region.NumCopiedInsts > opts::PartialInlineMaxInsts ||
+      Region.Blocks.size() > opts::PartialInlineMaxBlocks) {
+    const BinaryBasicBlock *Coldest = nullptr;
+    for (const BinaryBasicBlock *BB : llvm::drop_begin(Region.Blocks))
+      if (!Coldest || Region.Flow[BB] < Region.Flow[Coldest])
+        Coldest = BB;
+    if (Coldest)
+      Prune.push_back(Coldest);
+    return RR_TooLarge;
+  }
+
+  for (int R = NeedsRename.find_first(); R != -1; R = NeedsRename.find_next(R))
+    Region.RenamedRegs.push_back(R);
+  return RR_None;
+}
+
+bool PartialInlining::computeScratchCandidates(BinaryFunction &BF,
+                                               FastRegion &Region) {
+  BinaryContext &BC = BF.getBinaryContext();
+  const MCPlusBuilder &MIB = *BC.MIB;
+  const unsigned NumRegs = BC.MRI->getNumRegs();
+  Region.CalleeClobbers = BitVector(NumRegs, false);
+  Region.ScratchCandidates.clear();
+  if (Region.RenamedRegs.empty())
+    return true;
+
+  // Registers referenced by the copied instructions cannot be reused.
+  BitVector RegionRegs(NumRegs, false);
+  for (const BinaryBasicBlock *BB : Region.Blocks) {
+    for (const MCInst &Inst : *BB) {
+      if (Region.Dropped.count(&Inst) || MIB.isPseudo(Inst))
+        continue;
+      MIB.getUsedRegs(Inst, RegionRegs);
+      MIB.getWrittenRegs(Inst, RegionRegs);
+    }
+  }
+  Region.CalleeClobbers = getRegAnalysis(BC).getFunctionClobberList(&BF);
+
+  for (MCPhysReg From : Region.RenamedRegs) {
+    SmallVector<MCPhysReg, 16> All;
+    MIB.getCallSiteScratchRegs(From, All);
+    SmallVector<MCPhysReg, 8> &Candidates =
+        Region.ScratchCandidates.emplace_back();
+    for (MCPhysReg Cand : All) {
+      // The scratch register must be free in the copied code, and the callee
+      // must not depend on its value at entry when it re-executes.
+      if (getRegStorage(BC, Cand).anyCommon(RegionRegs) ||
+          isUpwardExposed(BC, BF, Cand))
+        continue;
+      Candidates.push_back(Cand);
+    }
+    if (Candidates.size() < 1)
+      return false;
+  }
+
+  // Verify that every copied instruction can be renamed (using the first
+  // candidate; all candidates of a register belong to the same class).
+  for (const BinaryBasicBlock *BB : Region.Blocks) {
+    for (const MCInst &Inst : *BB) {
+      if (Region.Dropped.count(&Inst) || MIB.isPseudo(Inst))
+        continue;
+      MCInst Copy = Inst;
+      for (unsigned I = 0; I < Region.RenamedRegs.size(); ++I)
+        if (!renameRegister(BC, Copy, Region.RenamedRegs[I],
+                            Region.ScratchCandidates[I].front()))
+          return false;
+    }
+  }
+  return true;
+}
+
+bool PartialInlining::isDeadAfterCall(const CallSite &Site, MCPhysReg Reg) {
+  BinaryContext &BC = Site.Caller->getBinaryContext();
+  const MCPlusBuilder &MIB = *BC.MIB;
+  RegAnalysis &RA = getRegAnalysis(BC);
+  const unsigned NumRegs = BC.MRI->getNumRegs();
+  const BitVector &Aliases = MIB.getAliases(Reg, /*OnlySmaller=*/false);
+
+  // Callers of the caller may rely on the register only if the caller never
+  // clobbers it (interprocedural register allocation).
+  const bool ClobberedByCaller =
+      RA.getFunctionClobberList(Site.Caller).test(Reg);
+  if (MIB.isTailCall(Site.BB->getInstructionAtIndex(Site.InstIdx)))
+    return ClobberedByCaller;
+
+  enum Result { Live, Dead, Unknown };
+  auto scan = [&](const BinaryBasicBlock &BB, unsigned From) {
+    for (unsigned I = From; I < BB.size(); ++I) {
+      const MCInst &Inst = BB.getInstructionAtIndex(I);
+      if (MIB.isPseudo(Inst))
+        continue;
+      const bool IsCall = MIB.isCall(Inst);
+      BitVector Used(NumRegs, false);
+      if (IsCall) {
+        RA.getInstUsedRegsList(Inst, Used, /*GetClobbers=*/false);
+        // Nothing is known about the callee: it follows the ABI and only
+        // reads argument registers.
+        if (RA.isConservative(Used))
+          Used = MIB.getRegsUsedAsParams();
+        for (const MCOperand &Op : MIB.useOperands(Inst))
+          if (Op.isReg() && Op.getReg())
+            Used |= MIB.getAliases(Op.getReg(), /*OnlySmaller=*/true);
+      } else {
+        MIB.getUsedRegs(Inst, Used);
+      }
+      if (Used.anyCommon(Aliases))
+        return Live;
+      if (MIB.isReturn(Inst) || (IsCall && MIB.isTailCall(Inst)))
+        return ClobberedByCaller ? Dead : Live;
+      if (IsCall) {
+        BitVector Clobbered(NumRegs, false);
+        RA.getInstClobberList(Inst, Clobbered);
+        // An unknown callee may clobber every caller-saved register, so the
+        // caller cannot keep a value in Reg across it either.
+        if (RA.isConservative(Clobbered) || Clobbered.test(Reg))
+          return Dead;
+        continue;
+      }
+      if (getFullyDefinedRegs(BC, Inst).test(Reg))
+        return Dead;
+    }
+    return Unknown;
+  };
+
+  SmallVector<const BinaryBasicBlock *, 16> Worklist;
+  DenseSet<const BinaryBasicBlock *> Visited;
+  auto pushSuccessors = [&](const BinaryBasicBlock &BB) {
+    for (const BinaryBasicBlock *Succ : BB.successors())
+      Worklist.push_back(Succ);
+    for (const BinaryBasicBlock *LP : BB.landing_pads())
+      Worklist.push_back(LP);
+  };
+  switch (scan(*Site.BB, Site.InstIdx + 1)) {
+  case Live:
+    return false;
+  case Dead:
+    return true;
+  case Unknown:
+    pushSuccessors(*Site.BB);
+    break;
+  }
+  while (!Worklist.empty()) {
+    const BinaryBasicBlock *BB = Worklist.pop_back_val();
+    if (!Visited.insert(BB).second)
+      continue;
+    switch (scan(*BB, 0)) {
+    case Live:
+      return false;
+    case Dead:
+      break;
+    case Unknown:
+      pushSuccessors(*BB);
+      break;
+    }
+  }
+  return true;
+}
+
+bool PartialInlining::chooseScratchRegisters(const CallSite &Site,
+                                             const FastRegion &Region,
+                                             RenameList &Renames) {
+  BinaryContext &BC = Site.Caller->getBinaryContext();
+  Renames.clear();
+  BitVector Assigned(BC.MRI->getNumRegs(), false);
+  for (unsigned I = 0; I < Region.RenamedRegs.size(); ++I) {
+    MCPhysReg Chosen = 0;
+    for (MCPhysReg Cand : Region.ScratchCandidates[I]) {
+      const BitVector &Storage = getRegStorage(BC, Cand);
+      if (Storage.anyCommon(Assigned))
+        continue;
+      // Registers clobbered by the original call are dead after it in every
+      // caller. Otherwise check the caller.
+      if (!Region.CalleeClobbers.test(Cand) && !isDeadAfterCall(Site, Cand))
+        continue;
+      Chosen = Cand;
+      Assigned |= Storage;
+      break;
+    }
+    if (!Chosen)
+      return false;
+    Renames.emplace_back(Region.RenamedRegs[I], Chosen);
+  }
+  return true;
+}
+
+PartialInlining::RejectReason
+PartialInlining::analyzeCallee(BinaryFunction &BF, FastRegion &Region) {
+  if (!shouldOptimize(BF) || BF.isMultiEntry() || BF.isPLTFunction() ||
+      BF.hasSDTMarker() || BF.hasIslandsInfo() || BF.empty() || BF.isInjected())
+    return RR_NotSimple;
+  if (llvm::any_of(opts::PartialInlineSkip,
+                   [&](const std::string &Name) { return BF.hasName(Name); }))
+    return RR_NotSimple;
+  if (!BF.hasValidProfile() || !BF.front().getKnownExecutionCount())
+    return RR_NoProfile;
+
+  DenseSet<const BinaryBasicBlock *> Excluded;
+  RejectReason Reason = RR_None;
+  SmallVector<const BinaryBasicBlock *, 8> Prune;
+  // The reason for the first pruning of a (warm) block. If pruning leaves no
+  // fast exit, it is the more informative explanation.
+  RejectReason PruneReason = RR_None;
+  for (unsigned Iter = 0; Iter < 4 * opts::PartialInlineMaxBlocks + 16;
+       ++Iter) {
+    Reason = buildRegion(BF, Region, Excluded, Prune);
+    if (Reason == RR_None || Prune.empty() ||
+        llvm::is_contained(Prune, &BF.front()))
+      break;
+    if (PruneReason == RR_None && Reason != RR_ColdFastPath)
+      PruneReason = Reason;
+    Excluded.insert(Prune.begin(), Prune.end());
+  }
+  if (Reason == RR_NoFastExit && PruneReason != RR_None)
+    Reason = PruneReason;
+  if (Reason != RR_None)
+    return Reason;
+  if (Region.FastProb * 100.0 < opts::PartialInlineMinFastRatio)
+    return RR_ColdFastPath;
+  if (!computeScratchCandidates(BF, Region))
+    return RR_NoScratch;
+  return RR_None;
+}
+
+bool PartialInlining::inlineFastPath(const CallSite &Site,
+                                     const FastRegion &Region,
+                                     const RenameList &Renames) {
+  BinaryFunction &Caller = *Site.Caller;
+  BinaryFunction &Callee = *Site.Callee;
+  BinaryContext &BC = Caller.getBinaryContext();
+  MCPlusBuilder &MIB = *BC.MIB;
+  BinaryBasicBlock *BB = Site.BB;
+
+  if (Site.InstIdx >= BB->size())
+    return false;
+  auto CallIt = BB->begin() + Site.InstIdx;
+  if (!MIB.isCall(*CallIt) || MIB.getTargetSymbol(*CallIt) == nullptr)
+    return false;
+  const bool IsTailCall = MIB.isTailCall(*CallIt);
+
+  // Validate the call site shape before modifying anything.
+  if (IsTailCall) {
+    if (std::next(CallIt) != BB->end() || BB->succ_size() != 0)
+      return false;
+  } else if (std::next(CallIt) == BB->end() && BB->succ_size() != 1) {
+    return false;
+  }
+
+  const int32_t CFIState = BB->getCFIStateAtInstr(&*CallIt);
+  const std::optional<bool> RAState = MIB.getRAState(*CallIt);
+  const uint64_t Count = Site.Count;
+  const double Scale =
+      Region.EntryFlow > 0 ? static_cast<double>(Count) / Region.EntryFlow : 0;
+
+  // Split off the code following the call.
+  BinaryBasicBlock *Cont = nullptr;
+  if (!IsTailCall) {
+    if (std::next(CallIt) != BB->end()) {
+      Cont = BB->splitAt(std::next(CallIt));
+      CallIt = BB->begin() + Site.InstIdx;
+    } else {
+      Cont = BB->getSuccessor();
+    }
+    BB->removeSuccessor(Cont);
+  }
+
+  // Move the original call into the slow-path block.
+  MCInst Call = *CallIt;
+  BB->eraseInstruction(CallIt);
+  BinaryBasicBlock *Slow = Caller.addBasicBlock();
+  Slow->setCFIState(CFIState);
+  Slow->addInstruction(std::move(Call));
+
+  // Create the copies of the region blocks.
+  DenseMap<const BinaryBasicBlock *, BinaryBasicBlock *> Clones;
+  for (const BinaryBasicBlock *RB : Region.Blocks) {
+    BinaryBasicBlock *NB = Caller.addBasicBlock();
+    NB->setCFIState(CFIState);
+    Clones[RB] = NB;
+  }
+
+  double SlowFlow = 0;
+  for (const BinaryBasicBlock *RB : Region.Blocks) {
+    BinaryBasicBlock *NB = Clones[RB];
+    const double Flow = Scale * Region.Flow.lookup(RB);
+    NB->setExecutionCount(static_cast<uint64_t>(std::llround(Flow)));
+
+    bool EndsInReturn = false;
+    for (const MCInst &Inst : *RB) {
+      if (Region.Dropped.count(&Inst) || MIB.isPseudo(Inst))
+        continue;
+      if (MIB.isReturn(Inst)) {
+        EndsInReturn = true;
+        if (IsTailCall) {
+          MCInst Ret;
+          MIB.createReturn(Ret);
+          if (RAState)
+            MIB.setRAState(Ret, *RAState);
+          NB->addInstruction(std::move(Ret));
+        }
+        continue;
+      }
+      MCInst NewInst = Inst;
+      MIB.stripAnnotations(NewInst);
+      for (const auto &[From, To] : Renames) {
+        const bool Renamed = renameRegister(BC, NewInst, From, To);
+        (void)Renamed;
+        assert(Renamed && "renaming was verified during analysis");
+      }
+      if (MIB.isBranch(NewInst)) {
+        const MCSymbol *Target = MIB.getTargetSymbol(NewInst);
+        const BinaryBasicBlock *TargetBB = Callee.getBasicBlockForLabel(Target);
+        BinaryBasicBlock *NewTarget =
+            TargetBB && Region.InRegion.count(TargetBB) ? Clones[TargetBB]
+                                                        : Slow;
+        MIB.replaceBranchTarget(NewInst, NewTarget->getLabel(), BC.Ctx.get());
+      }
+      if (RAState)
+        MIB.setRAState(NewInst, *RAState);
+      NB->addInstruction(std::move(NewInst));
+    }
+
+    // Successor edges, in the original order (taken, fall-through).
+    const SmallVector<double, 2> &Probs = Region.SuccProb.find(RB)->second;
+    unsigned I = 0;
+    for (const BinaryBasicBlock *Succ : RB->successors()) {
+      const double EdgeFlow = Flow * Probs[I++];
+      BinaryBasicBlock *Target = nullptr;
+      if (Region.InRegion.count(Succ)) {
+        Target = Clones[Succ];
+      } else {
+        Target = Slow;
+        SlowFlow += EdgeFlow;
+      }
+      NB->addSuccessor(Target, static_cast<uint64_t>(std::llround(EdgeFlow)),
+                       0);
+    }
+    if (EndsInReturn && !IsTailCall)
+      NB->addSuccessor(Cont, NB->getKnownExecutionCount(), 0);
+  }
+
+  Slow->setExecutionCount(static_cast<uint64_t>(std::llround(SlowFlow)));
+  // The call graph uses the call count annotation, if present, as the edge
+  // weight. Only slow-path invocations still call the callee.
+  if (ErrorOr<uint64_t &> CallCount =
+          MIB.tryGetAnnotationAs<uint64_t>(Slow->front(), "Count"))
+    *CallCount = Slow->getKnownExecutionCount();
+  if (!IsTailCall)
+    Slow->addSuccessor(Cont, Slow->getKnownExecutionCount(), 0);
+  BB->addSuccessor(Clones[Region.Blocks.front()], Count, 0);
+
+  // splitAt() does not move landing pad information, and the invoke (if any)
+  // moved to the slow-path block.
+  if (Caller.hasEHRanges() || MIB.isInvoke(Slow->front()))
+    Caller.recomputeLandingPads();
+  return true;
+}
+
+void PartialInlining::updateCalleeProfile(BinaryFunction &Callee,
+                                          const FastRegion &Region,
+                                          uint64_t CallCount) {
+  if (Region.EntryFlow <= 0)
+    return;
+  const double Scale =
+      std::min(1.0, static_cast<double>(CallCount) / Region.EntryFlow);
+  auto subtract = [](uint64_t Value, double Delta) -> uint64_t {
+    const int64_t D = std::llround(Delta);
+    return D >= static_cast<int64_t>(Value) ? 0 : Value - D;
+  };
+  for (BinaryBasicBlock *BB : Region.Blocks) {
+    const double Flow = Scale * Region.Flow.lookup(BB);
+    BB->setExecutionCount(
+        subtract(BB->getKnownExecutionCount(), Flow * Region.PFast.lookup(BB)));
+    const SmallVector<double, 2> &Probs = Region.SuccProb.find(BB)->second;
+    unsigned I = 0;
+    auto BI = BB->branch_info_begin();
+    for (const BinaryBasicBlock *Succ : BB->successors()) {
+      const double PFastSucc =
+          Region.InRegion.count(Succ) ? Region.PFast.lookup(Succ) : 0.0;
+      if (BI->Count != BinaryBasicBlock::COUNT_NO_PROFILE)
+        BI->Count = subtract(BI->Count, Flow * Probs[I] * PFastSucc);
+      ++I;
+      ++BI;
+    }
+  }
+  Callee.setExecutionCount(
+      subtract(Callee.getKnownExecutionCount(),
+               Scale * Region.EntryFlow * Region.FastProb));
+}
+
+Error PartialInlining::runOnFunctions(BinaryContext &BC) {
+  if (!opts::PartialInline)
+    return Error::success();
+  if (!BC.isAArch64() && !BC.isX86()) {
+    BC.errs() << "BOLT-WARNING: partial inlining is only supported on AArch64 "
+                 "and X86\n";
+    return Error::success();
+  }
+  const MCPlusBuilder &MIB = *BC.MIB;
+
+  // Analyze callees lazily, once.
+  std::map<BinaryFunction *, std::unique_ptr<FastRegion>> Regions;
+  auto getRegion = [&](BinaryFunction *Callee) -> FastRegion * {
+    auto [It, Inserted] = Regions.try_emplace(Callee);
+    if (!Inserted)
+      return It->second.get();
+    auto Region = std::make_unique<FastRegion>();
+    const RejectReason Reason = analyzeCallee(*Callee, *Region);
+    if (Reason != RR_None) {
+      ++NumRejected[Reason];
+      LLVM_DEBUG(dbgs() << "BOLT-DEBUG: partial inlining: " << *Callee
+                        << " rejected: " << getRejectReasonName(Reason)
+                        << '\n');
+      if (opts::Verbosity >= 2)
+        BC.outs() << "BOLT-INFO: partial inlining: no fast region in "
+                  << *Callee << ": " << getRejectReasonName(Reason)
+                  << " (exec count " << Callee->getKnownExecutionCount()
+                  << ")\n";
+      return nullptr;
+    }
+    ++NumCandidates;
+    NumFramedCandidates += Region->HasFrame;
+    LLVM_DEBUG(dbgs() << "BOLT-DEBUG: partial inlining: fast region in "
+                      << *Callee << ": " << Region->Blocks.size() << " blocks, "
+                      << Region->NumCopiedInsts
+                      << " instructions, p(fast) = " << Region->FastProb
+                      << ", renamed " << Region->RenamedRegs.size() << '\n');
+    It->second = std::move(Region);
+    return It->second.get();
+  };
+
+  const uint64_t MinCount = opts::PartialInlineMinCount
+                                ? opts::PartialInlineMinCount
+                                : BC.getHotThreshold();
+
+  // Collect eligible call sites.
+  std::vector<CallSite> Sites;
+  for (auto &BFI : BC.getBinaryFunctions()) {
+    BinaryFunction &Caller = BFI.second;
+    if (!shouldOptimize(Caller) || !Caller.hasValidProfile())
+      continue;
+    for (BinaryBasicBlock &BB : Caller) {
+      const uint64_t Count = BB.getKnownExecutionCount();
+      if (!Count)
+        continue;
+      for (unsigned Idx = 0; Idx < BB.size(); ++Idx) {
+        const MCInst &Inst = BB.getInstructionAtIndex(Idx);
+        if (!MIB.isCall(Inst) || MIB.isIndirectCall(Inst) ||
+            MIB.isConditionalBranch(Inst) ||
+            MCPlus::getNumPrimeOperands(Inst) != 1 ||
+            !Inst.getOperand(0).isExpr())
+          continue;
+        const MCSymbol *Target = MIB.getTargetSymbol(Inst);
+        uint64_t EntryID = 0;
+        BinaryFunction *Callee =
+            Target ? BC.getFunctionForSymbol(Target, &EntryID) : nullptr;
+        if (!Callee || EntryID != 0)
+          continue;
+        TotalDirectCalls += Count;
+        while (Callee->isFolded())
+          Callee = Callee->getFoldedIntoFunction();
+        if (Callee == &Caller || Count < MinCount)
+          continue;
+        FastRegion *Region = getRegion(Callee);
+        if (!Region)
+          continue;
+        const double Average = Region->FastProb;
+        const double WorstCase =
+            std::max(0.0, 1.0 - Region->SlowCount / static_cast<double>(Count));
+        const double FastProb = opts::PartialInlineModel == opts::PIM_WorstCase
+                                    ? std::min(Average, WorstCase)
+                                    : Average;
+        if (FastProb * 100.0 < opts::PartialInlineMinFastRatio)
+          continue;
+        Sites.push_back(
+            {&Caller, &BB, Idx, Callee, Count, FastProb, Count * FastProb});
+      }
+    }
+  }
+
+  // Select the hottest call sites covering the requested share of the
+  // eligible fast-path calls.
+  llvm::stable_sort(Sites, [](const CallSite &A, const CallSite &B) {
+    return A.Benefit > B.Benefit;
+  });
+  double TotalBenefit = 0;
+  for (const CallSite &Site : Sites)
+    TotalBenefit += Site.Benefit;
+  std::vector<CallSite> Selected;
+  double Covered = 0;
+  for (const CallSite &Site : Sites) {
+    if (Covered >= TotalBenefit * opts::PartialInlineCoverage / 100.0)
+      break;
+    if (opts::PartialInlineMaxSites &&
+        Selected.size() >= opts::PartialInlineMaxSites)
+      break;
+    Selected.push_back(Site);
+    Covered += Site.Benefit;
+  }
+
+  // Transform. Within a block, process call sites from the last to the first
+  // so that the recorded instruction indices remain valid.
+  llvm::stable_sort(Selected, [](const CallSite &A, const CallSite &B) {
+    if (A.BB != B.BB)
+      return A.Caller != B.Caller
+                 ? A.Caller->getAddress() < B.Caller->getAddress()
+                 : A.BB->getIndex() < B.BB->getIndex();
+    return A.InstIdx > B.InstIdx;
+  });
+  for (const CallSite &Site : Selected) {
+    const FastRegion &Region = *Regions[Site.Callee];
+    const bool IsTailCall =
+        MIB.isTailCall(Site.BB->getInstructionAtIndex(Site.InstIdx));
+    RenameList Renames;
+    if (!chooseScratchRegisters(Site, Region, Renames)) {
+      ++NumSitesNoScratch;
+      continue;
+    }
+    if (!inlineFastPath(Site, Region, Renames))
+      continue;
+    updateCalleeProfile(*Site.Callee, Region, Site.Count);
+    Modified.insert(Site.Caller);
+    ++NumInlinedSites;
+    NumInlinedFramedSites += Region.HasFrame;
+    NumTailCallSites += IsTailCall;
+    NumRenamedRegs += Renames.size();
+    NumCopiedInsts += Region.NumCopiedInsts;
+    DynFastCalls += Site.Count * Region.FastProb;
+    DynSlowCalls += Site.Count * (1.0 - Region.FastProb);
+    if (opts::Verbosity >= 1)
+      BC.outs() << "BOLT-INFO: partial inlining: " << *Site.Callee << " into "
+                << *Site.Caller << " (count " << Site.Count << ", p(fast) "
+                << format("%.3f", Region.FastProb) << " callee, "
+                << format("%.3f", Site.FastProb) << " site, "
+                << Region.NumCopiedInsts << " insns, " << Renames.size()
+                << " renamed regs" << (Region.HasFrame ? ", frame elided" : "")
+                << (IsTailCall ? ", tail call" : "") << ")\n";
+  }
+
+  BC.outs() << "BOLT-INFO: partial inlining: " << NumCandidates
+            << " callees with a fast region (" << NumFramedCandidates
+            << " with frame elision); inlined " << NumInlinedSites
+            << " call sites (" << NumInlinedFramedSites
+            << " with frame elision, " << NumTailCallSites << " tail calls), "
+            << NumCopiedInsts << " instructions copied, " << NumRenamedRegs
+            << " registers renamed\n";
+  if (NumSitesNoScratch)
+    BC.outs() << "BOLT-INFO: partial inlining: skipped " << NumSitesNoScratch
+              << " call sites without free scratch registers\n";
+  if (NumInlinedSites) {
+    BC.outs() << "BOLT-INFO: partial inlining: estimated "
+              << format("%.0f", DynFastCalls) << " calls avoided on fast paths";
+    if (TotalDirectCalls)
+      BC.outs() << " ("
+                << format("%.2f", 100.0 * DynFastCalls / TotalDirectCalls)
+                << "% of profiled direct calls)";
+    BC.outs() << ", " << format("%.0f", DynSlowCalls)
+              << " slow-path calls re-execute the copied region\n";
+  }
+  bool AnyRejected = false;
+  for (unsigned R = RR_None + 1; R < RR_Last; ++R)
+    AnyRejected |= NumRejected[R] != 0;
+  if (AnyRejected) {
+    BC.outs() << "BOLT-INFO: partial inlining: callees without a usable fast "
+                 "region:";
+    for (unsigned R = RR_None + 1; R < RR_Last; ++R)
+      if (NumRejected[R])
+        BC.outs() << ' ' << getRejectReasonName(static_cast<RejectReason>(R))
+                  << '=' << NumRejected[R];
+    BC.outs() << '\n';
+  }
+  return Error::success();
+}
+
