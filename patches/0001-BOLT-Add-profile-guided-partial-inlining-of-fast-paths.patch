+cl::opt<bool> PartialInline(
+    "partial-inline",
+    cl::desc("profile-guided partial inlining: copy the hot fast path of a "
+             "callee (eliding its stack frame) into hot call sites and fall "
+             "back to the original call on slow paths"),
+    cl::init(false), cl::cat(BoltOptCategory));
+
+static cl::opt<unsigned> PartialInlineMaxInsts(
+    "partial-inline-max-insns",
+    cl::desc("maximum number of callee instructions copied to a call site by "
+             "partial inlining"),
+    cl::init(24), cl::cat(BoltOptCategory));
+
+static cl::opt<unsigned> PartialInlineMaxBlocks(
+    "partial-inline-max-blocks",
+    cl::desc("maximum number of basic blocks in a partially inlined region"),
+    cl::init(8), cl::cat(BoltOptCategory));
+
+static cl::opt<unsigned> PartialInlineMinFastRatio(
+    "partial-inline-min-fast-ratio",
+    cl::desc("minimum estimated percentage of calls at a call site that take "
+             "the callee fast path"),
+    cl::init(60), cl::cat(BoltOptCategory));
+
+enum PartialInlineProfileModel : char { PIM_WorstCase, PIM_Average };
+
+static cl::opt<PartialInlineProfileModel> PartialInlineModel(
+    "partial-inline-profile-model",
+    cl::desc("how the fast-path probability at a call site is estimated from "
+             "the context-insensitive callee profile"),
+    cl::init(PIM_WorstCase),
+    cl::values(clEnumValN(PIM_WorstCase, "worst-case",
+                          "attribute the callee's slow-path invocations to the "
+                          "call site first (conservative)"),
+               clEnumValN(PIM_Average, "average",
+                          "use the callee-wide fast-path probability")),
+    cl::cat(BoltOptCategory));
+
+static cl::opt<uint64_t> PartialInlineMinCount(
+    "partial-inline-min-count",
+    cl::desc("minimum execution count of a call site considered for partial "
+             "inlining (0: use the BOLT hot threshold, i.e. half of the "
+             "average execution count of profiled functions)"),
+    cl::init(0), cl::cat(BoltOptCategory));
+
+static cl::opt<double> PartialInlineCoverage(
+    "partial-inline-coverage",
+    cl::desc("partially inline the hottest eligible call sites until they "
