diff --git a/bolt/test/AArch64/partial-inline-frame-elision.s b/bolt/test/AArch64/partial-inline-frame-elision.s
new file mode 100644
index 000000000..781e99d34
--- /dev/null
+++ b/bolt/test/AArch64/partial-inline-frame-elision.s
@@ -0,0 +1,121 @@
+## Check that partial inlining elides the callee's stack frame on the copied
+## fast path: callee-saved register spills/reloads, SP updates and frame pointer
+## setup are dropped, and callee-saved registers that the fast path uses as
+## temporaries are renamed to scratch registers clobbered by the call.
+
+# RUN: llvm-mc -filetype=obj -triple aarch64-unknown-unknown %s -o %t.o
+# RUN: link_fdata %s %t.o %t.fdata
+# RUN: %clang %cflags %t.o -o %t.exe -Wl,-q,--no-relax
+# RUN: llvm-strip --strip-unneeded %t.exe
+# RUN: llvm-bolt %t.exe -o %t.bolt --data %t.fdata --partial-inline -v=1 \
+# RUN:   --print-partial-inline --print-only=main 2>&1 | FileCheck %s
+
+## Frame elision can be disabled, in which case no fast region exists.
+# RUN: llvm-bolt %t.exe -o %t.nofe --data %t.fdata --partial-inline \
+# RUN:   --partial-inline-frame-elision=false 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=CHECK-NOFE
+# CHECK-NOFE: BOLT-INFO: partial inlining: 0 callees with a fast region
+# CHECK-NOFE: callees without a usable fast region:{{.*}} stack-access=1
+
+# CHECK: BOLT-INFO: partial inlining: memo_get into main (count 1000, p(fast) 0.950 callee, 0.950 site, 9 insns, 2 renamed regs, frame elided)
+# CHECK: BOLT-INFO: partial inlining: 1 callees with a fast region (1 with frame elision); inlined 1 call sites (1 with frame elision, 0 tail calls), 9 instructions copied, 2 registers renamed
+
+# CHECK:      Binary Function "main" after partial-inlining
+## The slow exit performs the original call.
+# CHECK:      [[SLOW:.LBB[0-9]+]] (1 instructions
+# CHECK-NEXT:   Exec Count : 50
+# CHECK-NEXT:   Predecessors: [[COPY:.LBB[0-9]+]]
+# CHECK-NEXT:   bl memo_get
+## The copy has no prologue: x19 and x20 are renamed to x10 and x11.
+# CHECK:      [[COPY]] (8 instructions
+# CHECK-NEXT:   Exec Count : 1000
+# CHECK-NEXT:   Predecessors:
+# CHECK-NEXT:   and x8, x0, #0xfff
+# CHECK-NEXT:   adrp x9, cache
+# CHECK-NEXT:   add x9, x9, :lo12:cache
+# CHECK-NEXT:   add x11, x0, #0x1
+# CHECK-NEXT:   add x10, x9, x8, lsl #4
+# CHECK-NEXT:   ldr x8, [x10]
+# CHECK-NEXT:   cmp x8, x11
+# CHECK-NEXT:   b.ne [[SLOW]]
+# CHECK-NEXT:   Successors: [[SLOW]] (mispreds: 0, count: 50), [[HIT:.LBB[0-9]+]] (mispreds: 0, count: 950)
+# CHECK:      [[HIT]] (1 instructions
+# CHECK-NEXT:   Exec Count : 950
+# CHECK-NEXT:   Predecessors: [[COPY]]
+# CHECK-NEXT:   ldr x0, [x10, #0x8]
+# CHECK-NEXT:   Successors: [[EPI:.LBB[0-9]+]]
+## No epilogue either: the reloads, the SP update and the return are gone.
+# CHECK:      [[EPI]] (0 instructions
+# CHECK-NEXT:   Exec Count : 950
+# CHECK-NOT:    ldp
+# CHECK:      End of Function "main"
+
+  .bss
+  .globl cache
+  .p2align 4
+cache:
+  .zero 65536
+
+  .text
+## uint64_t memo_get(uint64_t key) with a direct-mapped cache in front of
+## expensive(). Compiled code that keeps the entry address and key+1 in
+## callee-saved registers because they are live across the call on a miss.
+  .globl memo_get
+  .type memo_get,@function
+  .p2align 2
+memo_get:
+  stp x29, x30, [sp, #-32]!
+  stp x20, x19, [sp, #16]
+  mov x29, sp
+  and x8, x0, #0xfff
+  adrp x9, cache
+  add x9, x9, :lo12:cache
+  add x20, x0, #1
+  add x19, x9, x8, lsl #4
+  ldr x8, [x19]
+  cmp x8, x20
+memo_br:
+  b.ne memo_miss
+# FDATA: 1 memo_get #memo_br# 1 memo_get #memo_miss# 0 50
+# FDATA: 1 memo_get #memo_br# 1 memo_get #memo_hit# 0 950
+memo_hit:
+  ldr x0, [x19, #8]
+# FDATA: 1 memo_get #memo_hit# 1 memo_get #memo_epi# 0 950
+memo_epi:
+  ldp x20, x19, [sp, #16]
+  ldp x29, x30, [sp], #32
+  ret
+memo_miss:
+  bl expensive
+  stp x20, x0, [x19]
+memo_miss_br:
+  b memo_epi
+# FDATA: 1 memo_get #memo_miss_br# 1 memo_get #memo_epi# 0 50
+  .size memo_get, .-memo_get
+
+## Clobbers x10 and x11, so a call to memo_get clobbers them as well.
+  .globl expensive
+  .type expensive,@function
+  .p2align 2
+expensive:
+  eor x10, x0, x0, lsr #3
+  mul x11, x10, x10
+  add x0, x11, x10
+  ret
+  .size expensive, .-expensive
+
+  .globl main
+  .type main,@function
+  .p2align 2
+main:
+# FDATA: 0 [unknown] 0 1 main 0 0 1000
+  stp x29, x30, [sp, #-16]!
+  mov x29, sp
+  mov x0, #7
+main_call:
+  bl memo_get
+# FDATA: 1 main #main_call# 1 memo_get 0 0 1000
+  mov w0, wzr
+  ldp x29, x30, [sp], #16
+  ret
+  .size main, .-main
diff --git a/bolt/test/AArch64/partial-inline-frameless.s b/bolt/test/AArch64/partial-inline-frameless.s
new file mode 100644
index 000000000..e6e853dd7
--- /dev/null
+++ b/bolt/test/AArch64/partial-inline-frameless.s
@@ -0,0 +1,116 @@
+## Check that partial inlining copies the hot, frameless fast path of a callee
+## into a hot call site, redirects the slow exit to the original call, updates
+## the profile, and leaves the callee code untouched.
+
+# RUN: llvm-mc -filetype=obj -triple aarch64-unknown-unknown %s -o %t.o
+# RUN: link_fdata %s %t.o %t.fdata
+# RUN: %clang %cflags %t.o -o %t.exe -Wl,-q
+# RUN: llvm-strip --strip-unneeded %t.exe
+# RUN: llvm-bolt %t.exe -o %t.bolt --data %t.fdata --partial-inline \
+# RUN:   --print-partial-inline --print-only=main 2>&1 | FileCheck %s
+# RUN: llvm-objdump -d --no-show-raw-insn --disassemble-symbols=trace %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=CHECK-CALLEE
+# RUN: llvm-bolt %t.exe -o %t.bolt --data %t.fdata --partial-inline \
+# RUN:   --print-finalized --print-only=trace 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=CHECK-PROF
+
+## Without the option the pass does not run.
+# RUN: llvm-bolt %t.exe -o %t.nopi --data %t.fdata \
+# RUN:   | FileCheck %s --check-prefix=CHECK-OFF
+# CHECK-OFF-NOT: partial inlining
+
+# CHECK: BOLT-INFO: partial inlining: 1 callees with a fast region (0 with frame elision); inlined 1 call sites (0 with frame elision, 0 tail calls), 4 instructions copied, 0 registers renamed
+# CHECK: BOLT-INFO: partial inlining: estimated 990 calls avoided on fast paths (98.02% of profiled direct calls), 10 slow-path calls re-execute the copied region
+
+# CHECK:      Binary Function "main" after partial-inlining
+# CHECK:        mov w0, #0x5
+# CHECK-NEXT:   Successors: [[COPY:.LBB[0-9]+]] (mispreds: 0, count: 1000)
+## The code after the call.
+# CHECK:      [[CONT:.LBB[0-9]+]] (3 instructions
+# CHECK-NEXT:   Exec Count : 1000
+# CHECK:        mov w0, wzr
+## The slow exit performs the original call, which now executes 10 times.
+# CHECK:      [[SLOW:.LBB[0-9]+]] (1 instructions
+# CHECK-NEXT:   Exec Count : 10
+# CHECK-NEXT:   Predecessors: [[COPY]]
+# CHECK-NEXT:   bl trace # Count: 10
+# CHECK-NEXT:   Successors: [[CONT]] (mispreds: 0, count: 10)
+## The copied fast path.
+# CHECK:      [[COPY]] (4 instructions
+# CHECK-NEXT:   Exec Count : 1000
+# CHECK-NEXT:   Predecessors:
+# CHECK-NEXT:   adrp x8, trace_level
+# CHECK-NEXT:   ldr w8, [x8, :lo12:trace_level]
+# CHECK-NEXT:   cmp w0, w8
+# CHECK-NEXT:   b.gt [[SLOW]]
+# CHECK-NEXT:   Successors: [[SLOW]] (mispreds: 0, count: 10), [[RET:.LBB[0-9]+]] (mispreds: 0, count: 990)
+## The return became a fall-through to the code after the call.
+# CHECK:      [[RET]] (0 instructions
+# CHECK-NEXT:   Exec Count : 990
+# CHECK-NEXT:   Predecessors: [[COPY]]
+# CHECK-NEXT:   Successors: [[CONT]] (mispreds: 0, count: 990)
+
+## The callee code is not modified ...
+# CHECK-CALLEE:      <trace>:
+# CHECK-CALLEE-NEXT:   adrp x8
+# CHECK-CALLEE-NEXT:   ldr w8, [x8
+# CHECK-CALLEE-NEXT:   cmp w0, w8
+# CHECK-CALLEE-NEXT:   b.gt
+# CHECK-CALLEE-NEXT:   ret
+# CHECK-CALLEE-NEXT:   stp x29, x30, [sp, #-0x10]!
+
+## ... but its profile only retains the slow-path invocations.
+# CHECK-PROF:      Binary Function "trace" after finalize-functions
+# CHECK-PROF:        Exec Count  : 10
+
+  .data
+  .globl trace_level
+  .p2align 2
+trace_level:
+  .word 0
+
+  .text
+## trace(level): if (level > trace_level) return; emit();
+  .globl trace
+  .type trace,@function
+  .p2align 2
+trace:
+  adrp x8, trace_level
+  ldr w8, [x8, :lo12:trace_level]
+  cmp w0, w8
+trace_br:
+  b.gt trace_slow
+# FDATA: 1 trace #trace_br# 1 trace #trace_slow# 0 10
+# FDATA: 1 trace #trace_br# 1 trace #trace_ret# 0 990
+trace_ret:
+  ret
+trace_slow:
+  stp x29, x30, [sp, #-16]!
+  mov x29, sp
+  bl emit
+  ldp x29, x30, [sp], #16
+  ret
+  .size trace, .-trace
+
+  .globl emit
+  .type emit,@function
+  .p2align 2
+emit:
+  ret
+  .size emit, .-emit
+
+  .globl main
+  .type main,@function
+  .p2align 2
+main:
+# FDATA: 0 [unknown] 0 1 main 0 0 1000
+  stp x29, x30, [sp, #-16]!
+  mov x29, sp
+  mov w0, #5
+main_call:
+  bl trace
+# FDATA: 1 main #main_call# 1 trace 0 0 1000
+  mov w0, wzr
+  ldp x29, x30, [sp], #16
+  ret
+  .size main, .-main
diff --git a/bolt/test/AArch64/partial-inline-pauth.s b/bolt/test/AArch64/partial-inline-pauth.s
new file mode 100644
index 000000000..91a3e883f
--- /dev/null
+++ b/bolt/test/AArch64/partial-inline-pauth.s
@@ -0,0 +1,195 @@
+## Check partial inlining with pointer authentication and BTI:
+##  * BTI landing pads at the callee entry are not copied;
+##  * return address signing/authentication of the callee is elided together
+##    with the rest of its frame;
+##  * the copied instructions take the RA state of the call site in the
+##    (pac-ret protected) caller, so no additional negate_ra_state is needed.
+
+# RUN: llvm-mc -filetype=obj -triple aarch64-unknown-unknown \
+# RUN:   -mattr=+v8.3a,+bti %s -o %t.o
+# RUN: link_fdata %s %t.o %t.fdata
+# RUN: %clang %cflags %t.o -o %t.exe -Wl,-q
+# RUN: llvm-strip --strip-unneeded %t.exe
+# RUN: llvm-bolt %t.exe -o %t.bolt --data %t.fdata --partial-inline -v=1 \
+# RUN:   --print-partial-inline --print-only=main 2>&1 | FileCheck %s
+# RUN: llvm-objdump -d --no-show-raw-insn --disassemble-symbols=main %t.bolt \
+# RUN:   > %t.main.txt
+# RUN: FileCheck %s --check-prefix=CHECK-MAIN < %t.main.txt
+# RUN: FileCheck %s --check-prefix=CHECK-COPY < %t.main.txt
+
+# CHECK-NOT: BOLT-ERROR
+# CHECK-DAG: partial inlining: lookup into main (count 1000, p(fast) 0.990 callee, 0.990 site, 6 insns, 0 renamed regs)
+# CHECK-DAG: partial inlining: lookup2 into main (count 1000, p(fast) 0.990 callee, 0.990 site, 3 insns, 1 renamed regs, frame elided)
+# CHECK: Binary Function "main" after partial-inlining
+# CHECK-NOT: bti
+# CHECK: End of Function "main"
+
+## main signs and authenticates its return address exactly once; the copies
+## add no signing, authentication or landing pads.
+# CHECK-MAIN:      <main>:
+# CHECK-MAIN-NEXT:   paciasp
+# CHECK-MAIN-NOT:    {{paciasp|bti|retaa}}
+# CHECK-MAIN:        autiasp
+# CHECK-MAIN-NOT:    {{paciasp|autiasp|bti|retaa}}
+
+## Both fast paths are present, x19 of lookup2 is renamed to x9, and both
+## callees are still called on the slow paths.
+# CHECK-COPY-DAG:    ldr x8, [x8, #0x8]
+# CHECK-COPY-DAG:    cmp x8, x1
+# CHECK-COPY-DAG:    add x0, x1, #0x1
+# CHECK-COPY-DAG:    ldr x9, [x0]
+# CHECK-COPY-DAG:    cbz x9,
+# CHECK-COPY-DAG:    ldr x0, [x9, #0x8]
+# CHECK-COPY-DAG:    bl {{.*}} <lookup>
+# CHECK-COPY-DAG:    bl {{.*}} <lookup2>
+
+  .text
+## Shrink-wrapped by the compiler: the fast path only has a BTI landing pad.
+  .globl lookup
+  .type lookup,@function
+  .p2align 2
+lookup:
+  .cfi_startproc
+  hint #34
+  ldr x8, [x0]
+lookup_br1:
+  cbz x8, lookup_slow
+# FDATA: 1 lookup #lookup_br1# 1 lookup #lookup_slow# 0 5
+# FDATA: 1 lookup #lookup_br1# 1 lookup #lookup_bb1# 0 995
+lookup_bb1:
+  ldr x8, [x8, #8]
+  cmp x8, x1
+lookup_br2:
+  b.ne lookup_slow
+# FDATA: 1 lookup #lookup_br2# 1 lookup #lookup_slow# 0 5
+# FDATA: 1 lookup #lookup_br2# 1 lookup #lookup_bb2# 0 990
+lookup_bb2:
+  add x0, x1, #1
+  ret
+lookup_slow:
+  hint #25
+  .cfi_negate_ra_state
+  stp x29, x30, [sp, #-32]!
+  str x19, [sp, #16]
+  mov x29, sp
+  .cfi_def_cfa w29, 32
+  .cfi_offset w19, -16
+  .cfi_offset w30, -24
+  .cfi_offset w29, -32
+  mov x19, x1
+  bl slow_lookup
+  add x0, x0, x19
+  ldr x19, [sp, #16]
+  ldp x29, x30, [sp], #32
+  .cfi_def_cfa wsp, 0
+  hint #29
+  .cfi_negate_ra_state
+  .cfi_restore w19
+  .cfi_restore w30
+  .cfi_restore w29
+  ret
+  .cfi_endproc
+  .size lookup, .-lookup
+
+## Not shrink-wrapped: signs the return address in the prologue.
+  .globl lookup2
+  .type lookup2,@function
+  .p2align 2
+lookup2:
+  .cfi_startproc
+  hint #34
+  hint #25
+  .cfi_negate_ra_state
+  stp x29, x30, [sp, #-32]!
+  .cfi_def_cfa_offset 32
+  str x19, [sp, #16]
+  mov x29, sp
+  .cfi_def_cfa w29, 32
+  .cfi_offset w19, -16
+  .cfi_offset w30, -24
+  .cfi_offset w29, -32
+  ldr x19, [x0]
+lookup2_br:
+  cbz x19, lookup2_slow
+# FDATA: 1 lookup2 #lookup2_br# 1 lookup2 #lookup2_slow# 0 10
+# FDATA: 1 lookup2 #lookup2_br# 1 lookup2 #lookup2_fast# 0 990
+lookup2_fast:
+  ldr x0, [x19, #8]
+  .cfi_remember_state
+  ldr x19, [sp, #16]
+  ldp x29, x30, [sp], #32
+  .cfi_def_cfa wsp, 0
+  hint #29
+  .cfi_negate_ra_state
+  .cfi_restore w19
+  .cfi_restore w30
+  .cfi_restore w29
+  ret
+lookup2_slow:
+  .cfi_restore_state
+  bl slow_lookup
+  ldr x19, [sp, #16]
+  ldp x29, x30, [sp], #32
+  .cfi_def_cfa wsp, 0
+  hint #29
+  .cfi_negate_ra_state
+  .cfi_restore w19
+  .cfi_restore w30
+  .cfi_restore w29
+  ret
+  .cfi_endproc
+  .size lookup2, .-lookup2
+
+## Clobbers x9, so x9 is a valid scratch register at calls to lookup2.
+  .globl slow_lookup
+  .type slow_lookup,@function
+  .p2align 2
+slow_lookup:
+  .cfi_startproc
+  hint #34
+  mov x9, x0
+  ldr x0, [x9]
+  ret
+  .cfi_endproc
+  .size slow_lookup, .-slow_lookup
+
+  .globl main
+  .type main,@function
+  .p2align 2
+main:
+  .cfi_startproc
+# FDATA: 0 [unknown] 0 1 main 0 0 1000
+  hint #25
+  .cfi_negate_ra_state
+  stp x29, x30, [sp, #-16]!
+  .cfi_def_cfa_offset 16
+  mov x29, sp
+  .cfi_def_cfa w29, 16
+  .cfi_offset w30, -8
+  .cfi_offset w29, -16
+  adrp x0, slot
+  add x0, x0, :lo12:slot
+  mov x1, #3
+main_call1:
+  bl lookup
+# FDATA: 1 main #main_call1# 1 lookup 0 0 1000
+  adrp x0, slot
+  add x0, x0, :lo12:slot
+main_call2:
+  bl lookup2
+# FDATA: 1 main #main_call2# 1 lookup2 0 0 1000
+  ldp x29, x30, [sp], #16
+  .cfi_def_cfa wsp, 0
+  hint #29
+  .cfi_negate_ra_state
+  .cfi_restore w30
+  .cfi_restore w29
+  ret
+  .cfi_endproc
+  .size main, .-main
+
+  .data
+  .globl slot
+  .p2align 3
+slot:
+  .xword 0
diff --git a/bolt/test/AArch64/partial-inline-reject.s b/bolt/test/AArch64/partial-inline-reject.s
new file mode 100644
index 000000000..1705772dc
--- /dev/null
+++ b/bolt/test/AArch64/partial-inline-reject.s
@@ -0,0 +1,252 @@
+## Check that partial inlining rejects hot fast paths that cannot be copied
+## safely, and that the calls to them are left unchanged.
+
+# RUN: llvm-mc -filetype=obj -triple aarch64-unknown-unknown %s -o %t.o
+# RUN: link_fdata %s %t.o %t.fdata
+# RUN: %clang %cflags %t.o -o %t.exe -Wl,-q
+# RUN: llvm-strip --strip-unneeded %t.exe
+# RUN: llvm-bolt %t.exe -o %t.bolt --data %t.fdata --partial-inline -v=2 \
+# RUN:   2>&1 | FileCheck %s
+# RUN: llvm-objdump -d --no-show-raw-insn --disassemble-symbols=main %t.bolt \
+# RUN:   | FileCheck %s --check-prefix=CHECK-MAIN
+
+## A store before the fast/slow decision would be repeated on the slow path.
+# CHECK-DAG: no fast region in rc_release: side-effect
+## So would a barrier.
+# CHECK-DAG: no fast region in fenced: side-effect
+## The argument register is overwritten before the decision, so the callee
+## would re-execute with a different argument.
+# CHECK-DAG: no fast region in chain: reg-clobber
+## The stack pointer and the return address differ between caller and callee.
+# CHECK-DAG: no fast region in stackaddr: stack-access
+# CHECK-DAG: no fast region in retaddr: stack-access
+## A load from the caller's frame (a stack argument) is not a reload of a spill.
+# CHECK-DAG: no fast region in stackarg: frame-mismatch
+## A callee-saved register is modified and not restored on the fast path.
+# CHECK-DAG: no fast region in unbalanced: frame-mismatch
+## A renamed callee-saved register is read on the fast path, but it is only
+## written on one of the paths reaching the read.
+# CHECK-DAG: no fast region in halfdirty: frame-mismatch
+## The fast path is taken by only 10% of the calls.
+# CHECK-DAG: no fast region in rarely: cold-fast-path
+## The entry block is a loop header.
+# CHECK-DAG: no fast region in looping: no-fast-exit
+
+# CHECK: BOLT-INFO: partial inlining: 0 callees with a fast region (0 with frame elision); inlined 0 call sites
+# CHECK: callees without a usable fast region:{{.*}} no-fast-exit=1 stack-access=2 frame-mismatch=3 side-effect=2 reg-clobber=1 {{.*}}cold-fast-path=1
+
+# CHECK-MAIN: bl {{.*}} <rc_release>
+# CHECK-MAIN: bl {{.*}} <fenced>
+# CHECK-MAIN: bl {{.*}} <chain>
+# CHECK-MAIN: bl {{.*}} <stackaddr>
+# CHECK-MAIN: bl {{.*}} <retaddr>
+# CHECK-MAIN: bl {{.*}} <stackarg>
+# CHECK-MAIN: bl {{.*}} <unbalanced>
+# CHECK-MAIN: bl {{.*}} <halfdirty>
+# CHECK-MAIN: bl {{.*}} <rarely>
+# CHECK-MAIN: bl {{.*}} <looping>
+
+  .text
+  .macro SLOWPATH name
+\name\()_slow:
+  stp x29, x30, [sp, #-16]!
+  mov x29, sp
+  bl helper
+  ldp x29, x30, [sp], #16
+  ret
+  .endm
+
+  .macro FUNC name
+  .globl \name
+  .type \name,@function
+  .p2align 2
+\name:
+  .endm
+
+FUNC rc_release
+  ldr x8, [x0]
+  subs x8, x8, #1
+  str x8, [x0]
+rc_release_br:
+  b.eq rc_release_slow
+# FDATA: 1 rc_release #rc_release_br# 1 rc_release #rc_release_slow# 0 10
+# FDATA: 1 rc_release #rc_release_br# 1 rc_release #rc_release_fast# 0 990
+rc_release_fast:
+  mov w0, wzr
+  ret
+  SLOWPATH rc_release
+  .size rc_release, .-rc_release
+
+FUNC fenced
+  dmb ish
+  ldr x8, [x0]
+fenced_br:
+  cbz x8, fenced_slow
+# FDATA: 1 fenced #fenced_br# 1 fenced #fenced_slow# 0 10
+# FDATA: 1 fenced #fenced_br# 1 fenced #fenced_fast# 0 990
+fenced_fast:
+  mov x0, x8
+  ret
+  SLOWPATH fenced
+  .size fenced, .-fenced
+
+FUNC chain
+  ldr x0, [x0, #8]
+  ldr x8, [x0]
+chain_br:
+  cbz x8, chain_slow
+# FDATA: 1 chain #chain_br# 1 chain #chain_slow# 0 10
+# FDATA: 1 chain #chain_br# 1 chain #chain_fast# 0 990
+chain_fast:
+  mov x0, x8
+  ret
+  SLOWPATH chain
+  .size chain, .-chain
+
+FUNC stackaddr
+  mov x8, sp
+  ldr x8, [x8, #8]
+stackaddr_br:
+  cbz x8, stackaddr_slow
+# FDATA: 1 stackaddr #stackaddr_br# 1 stackaddr #stackaddr_slow# 0 10
+# FDATA: 1 stackaddr #stackaddr_br# 1 stackaddr #stackaddr_fast# 0 990
+stackaddr_fast:
+  mov x0, x8
+  ret
+  SLOWPATH stackaddr
+  .size stackaddr, .-stackaddr
+
+FUNC retaddr
+  cmp x0, #0
+retaddr_br:
+  b.eq retaddr_slow
+# FDATA: 1 retaddr #retaddr_br# 1 retaddr #retaddr_slow# 0 10
+# FDATA: 1 retaddr #retaddr_br# 1 retaddr #retaddr_fast# 0 990
+retaddr_fast:
+  mov x0, x30
+  ret
+  SLOWPATH retaddr
+  .size retaddr, .-retaddr
+
+FUNC stackarg
+  ldr x8, [sp]
+stackarg_br:
+  cbz x8, stackarg_slow
+# FDATA: 1 stackarg #stackarg_br# 1 stackarg #stackarg_slow# 0 10
+# FDATA: 1 stackarg #stackarg_br# 1 stackarg #stackarg_fast# 0 990
+stackarg_fast:
+  mov x0, x8
+  ret
+  SLOWPATH stackarg
+  .size stackarg, .-stackarg
+
+FUNC unbalanced
+  stp x29, x30, [sp, #-32]!
+  str x19, [sp, #16]
+  mov x29, sp
+  ldr x19, [x0]
+unbalanced_br:
+  cbz x19, unbalanced_slow
+# FDATA: 1 unbalanced #unbalanced_br# 1 unbalanced #unbalanced_slow# 0 10
+# FDATA: 1 unbalanced #unbalanced_br# 1 unbalanced #unbalanced_fast# 0 990
+unbalanced_fast:
+  mov x0, x19
+  ldp x29, x30, [sp], #32
+  ret
+unbalanced_slow:
+  bl helper
+  ldr x19, [sp, #16]
+  ldp x29, x30, [sp], #32
+  ret
+  .size unbalanced, .-unbalanced
+
+FUNC halfdirty
+  stp x29, x30, [sp, #-32]!
+  str x19, [sp, #16]
+  mov x29, sp
+halfdirty_br1:
+  cbz x0, halfdirty_join
+# FDATA: 1 halfdirty #halfdirty_br1# 1 halfdirty #halfdirty_join# 0 500
+# FDATA: 1 halfdirty #halfdirty_br1# 1 halfdirty #halfdirty_set# 0 500
+halfdirty_set:
+  mov x19, x1
+halfdirty_join:
+  ldr x8, [x2]
+halfdirty_br2:
+  cbz x8, halfdirty_slow
+# FDATA: 1 halfdirty #halfdirty_br2# 1 halfdirty #halfdirty_slow# 0 10
+# FDATA: 1 halfdirty #halfdirty_br2# 1 halfdirty #halfdirty_fast# 0 990
+halfdirty_fast:
+  add x0, x19, #1
+  ldr x19, [sp, #16]
+  ldp x29, x30, [sp], #32
+  ret
+halfdirty_slow:
+  bl helper
+  ldr x19, [sp, #16]
+  ldp x29, x30, [sp], #32
+  ret
+  .size halfdirty, .-halfdirty
+
+FUNC rarely
+  ldr x8, [x0]
+rarely_br:
+  cbnz x8, rarely_slow
+# FDATA: 1 rarely #rarely_br# 1 rarely #rarely_slow# 0 900
+# FDATA: 1 rarely #rarely_br# 1 rarely #rarely_fast# 0 100
+rarely_fast:
+  ret
+  SLOWPATH rarely
+  .size rarely, .-rarely
+
+FUNC looping
+  sub x0, x0, #1
+looping_br:
+  cbnz x0, looping
+# FDATA: 1 looping #looping_br# 1 looping 0 0 9000
+# FDATA: 1 looping #looping_br# 1 looping #looping_ret# 0 1000
+looping_ret:
+  ret
+  .size looping, .-looping
+
+FUNC helper
+  ret
+  .size helper, .-helper
+
+FUNC main
+# FDATA: 0 [unknown] 0 1 main 0 0 1000
+  stp x29, x30, [sp, #-16]!
+  mov x29, sp
+call_rc_release:
+  bl rc_release
+# FDATA: 1 main #call_rc_release# 1 rc_release 0 0 1000
+call_fenced:
+  bl fenced
+# FDATA: 1 main #call_fenced# 1 fenced 0 0 1000
+call_chain:
+  bl chain
+# FDATA: 1 main #call_chain# 1 chain 0 0 1000
+call_stackaddr:
+  bl stackaddr
+# FDATA: 1 main #call_stackaddr# 1 stackaddr 0 0 1000
+call_retaddr:
+  bl retaddr
+# FDATA: 1 main #call_retaddr# 1 retaddr 0 0 1000
+call_stackarg:
+  bl stackarg
+# FDATA: 1 main #call_stackarg# 1 stackarg 0 0 1000
+call_unbalanced:
+  bl unbalanced
+# FDATA: 1 main #call_unbalanced# 1 unbalanced 0 0 1000
+call_halfdirty:
+  bl halfdirty
+# FDATA: 1 main #call_halfdirty# 1 halfdirty 0 0 1000
+call_rarely:
+  bl rarely
+# FDATA: 1 main #call_rarely# 1 rarely 0 0 1000
+call_looping:
+  bl looping
+# FDATA: 1 main #call_looping# 1 looping 0 0 1000
+  ldp x29, x30, [sp], #16
+  ret
+  .size main, .-main
diff --git a/bolt/test/AArch64/partial-inline-sites.s b/bolt/test/AArch64/partial-inline-sites.s
new file mode 100644
index 000000000..fdb5d20b3
--- /dev/null
+++ b/bolt/test/AArch64/partial-inline-sites.s
@@ -0,0 +1,130 @@
+## Check call site handling of partial inlining:
+##  * at a tail call site the copied fast path returns directly and the slow
+##    exit performs the original tail call;
+##  * with the default worst-case profile model, a call site whose share of the
+##    calls could consist of slow-path invocations only is not transformed,
+##    while the average model transforms it;
+##  * --partial-inline-min-fast-ratio and --partial-inline-min-count apply per
+##    call site.
+
+# RUN: llvm-mc -filetype=obj -triple aarch64-unknown-unknown %s -o %t.o
+# RUN: link_fdata %s %t.o %t.fdata
+# RUN: %clang %cflags %t.o -o %t.exe -Wl,-q
+# RUN: llvm-strip --strip-unneeded %t.exe
+# RUN: llvm-bolt %t.exe -o %t.bolt --data %t.fdata --partial-inline -v=1 \
+# RUN:   --partial-inline-min-count=1 \
+# RUN:   --print-partial-inline --print-only=wrapper 2>&1 \
+# RUN:   | FileCheck %s --check-prefixes=CHECK,WORST
+# RUN: llvm-bolt %t.exe -o %t.avg --data %t.fdata --partial-inline -v=1 \
+# RUN:   --partial-inline-min-count=1 \
+# RUN:   --partial-inline-profile-model=average 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=AVG
+# RUN: llvm-bolt %t.exe -o %t.ratio --data %t.fdata --partial-inline -v=2 \
+# RUN:   --partial-inline-profile-model=average \
+# RUN:   --partial-inline-min-fast-ratio=90 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=RATIO
+# RUN: llvm-bolt %t.exe -o %t.count --data %t.fdata --partial-inline -v=1 \
+# RUN:   --partial-inline-min-count=2000 2>&1 \
+# RUN:   | FileCheck %s --check-prefix=COUNT
+
+## classify() is called 7000 times (3000 + 1000 + 3000 tail calls) and 1000
+## invocations take the slow path, so 85.7% are fast on average. hot_site and
+## wrapper make 3000 calls each: even if all slow invocations came from one
+## of them, 66.7% of its calls would be fast. cold_site makes 1000 calls, all
+## of which may be the slow ones.
+# WORST-DAG: partial inlining: classify into hot_site (count 3000, p(fast) 0.857 callee, 0.667 site, 3 insns, 0 renamed regs)
+# WORST-DAG: partial inlining: classify into wrapper (count 3000, p(fast) 0.857 callee, 0.667 site, 3 insns, 0 renamed regs, tail call)
+# WORST-NOT: classify into cold_site
+# AVG-DAG:   classify into hot_site (count 3000, p(fast) 0.857 callee, 0.857 site
+# AVG-DAG:   classify into cold_site (count 1000, p(fast) 0.857 callee, 0.857 site
+# AVG-DAG:   classify into wrapper (count 3000
+# RATIO:     no fast region in classify: cold-fast-path
+# RATIO:     inlined 0 call sites
+# COUNT-NOT: classify into cold_site
+# COUNT:     inlined 2 call sites (0 with frame elision, 1 tail calls)
+
+## The tail call site: the copy keeps the return, the slow exit is the
+## original tail call.
+# CHECK:      Binary Function "wrapper" after partial-inlining
+# CHECK:        add x0, x0, #0x10
+# CHECK-NEXT:   Successors: [[COPY:.LBB[0-9]+]] (mispreds: 0, count: 3000)
+# CHECK:      [[SLOW:.LBB[0-9]+]] (1 instructions
+# CHECK-NEXT:   Exec Count : 429
+# CHECK-NEXT:   Predecessors: [[COPY]]
+# CHECK-NEXT:   b classify # TAILCALL # Count: 429
+# CHECK:      [[COPY]] (2 instructions
+# CHECK-NEXT:   Exec Count : 3000
+# CHECK-NEXT:   Predecessors:
+# CHECK-NEXT:   ldr x8, [x0]
+# CHECK-NEXT:   cbnz x8, [[SLOW]]
+# CHECK:      {{.LBB[0-9]+}} (2 instructions
+# CHECK-NEXT:   Exec Count : 2571
+# CHECK-NEXT:   Predecessors: [[COPY]]
+# CHECK-NEXT:   ldr x0, [x0, #0x8]
+# CHECK-NEXT:   ret
+
+  .text
+  .macro FUNC name
+  .globl \name
+  .type \name,@function
+  .p2align 2
+\name:
+  .endm
+
+## classify(it): kind == 0 ? it->w : slow(it)
+FUNC classify
+  ldr x8, [x0]
+classify_br:
+  cbnz x8, classify_slow
+# FDATA: 1 classify #classify_br# 1 classify #classify_slow# 0 1000
+# FDATA: 1 classify #classify_br# 1 classify #classify_fast# 0 6000
+classify_fast:
+  ldr x0, [x0, #8]
+  ret
+classify_slow:
+  stp x29, x30, [sp, #-16]!
+  mov x29, sp
+  bl helper
+  ldp x29, x30, [sp], #16
+  ret
+  .size classify, .-classify
+
+FUNC helper
+  ret
+  .size helper, .-helper
+
+FUNC hot_site
+# FDATA: 0 [unknown] 0 1 hot_site 0 0 3000
+  stp x29, x30, [sp, #-16]!
+  mov x29, sp
+hot_call:
+  bl classify
+# FDATA: 1 hot_site #hot_call# 1 classify 0 0 3000
+  ldp x29, x30, [sp], #16
+  ret
+  .size hot_site, .-hot_site
+
+FUNC cold_site
+# FDATA: 0 [unknown] 0 1 cold_site 0 0 1000
+  stp x29, x30, [sp, #-16]!
+  mov x29, sp
+cold_call:
+  bl classify
+# FDATA: 1 cold_site #cold_call# 1 classify 0 0 1000
+  ldp x29, x30, [sp], #16
+  ret
+  .size cold_site, .-cold_site
+
+## A wrapper ending in a tail call. Its calls are not counted as calls to
+## classify by the profile above; it gets its own counts.
+FUNC wrapper
+# FDATA: 0 [unknown] 0 1 wrapper 0 0 3000
+  add x0, x0, #16
+wrapper_call:
+  b classify
+# FDATA: 1 wrapper #wrapper_call# 1 classify 0 0 3000
+  .size wrapper, .-wrapper
+
+FUNC main
+  ret
+  .size main, .-main
diff --git a/bolt/test/X86/partial-inline.s b/bolt/test/X86/partial-inline.s
new file mode 100644
index 000000000..263688f05
--- /dev/null
+++ b/bolt/test/X86/partial-inline.s
@@ -0,0 +1,107 @@
+## Check partial inlining on x86-64: the frameless fast path of a callee
+## (including its CET landing pad, which is not copied) is inlined into a hot
+## call site; callees whose fast path manipulates the stack are rejected since
+## frame elision is only implemented for AArch64.
+
+# RUN: llvm-mc -filetype=obj -triple x86_64-unknown-unknown %s -o %t.o
+# RUN: link_fdata %s %t.o %t.fdata
+# RUN: llvm-strip --strip-unneeded %t.o
+# RUN: %clang %cflags %t.o -o %t.exe -Wl,-q
+# RUN: llvm-bolt %t.exe -o %t.bolt --data %t.fdata --partial-inline -v=2 \
+# RUN:   --print-partial-inline --print-only=main 2>&1 | FileCheck %s
+
+# CHECK-DAG: partial inlining: trace into main (count 1000, p(fast) 0.990 callee, 0.990 site, 2 insns, 0 renamed regs)
+# CHECK-DAG: partial inlining: no fast region in pushy: stack-access
+# CHECK: BOLT-INFO: partial inlining: 1 callees with a fast region (0 with frame elision); inlined 1 call sites
+
+# CHECK:      Binary Function "main" after partial-inlining
+# CHECK:      [[SLOW:.LBB[0-9]+]] (1 instructions
+# CHECK-NEXT:   Exec Count : 10
+# CHECK-NEXT:   Predecessors: [[COPY:.LBB[0-9]+]]
+# CHECK-NEXT:   callq trace
+# CHECK:      [[COPY]] (2 instructions
+# CHECK-NEXT:   Exec Count : 1000
+# CHECK-NEXT:   Predecessors:
+# CHECK-NOT:    endbr64
+# CHECK-NEXT:   cmpl trace_level(%rip), %edi
+# CHECK-NEXT:   jg [[SLOW]]
+# CHECK:      End of Function "main"
+
+  .text
+  .globl trace
+  .type trace,@function
+  .p2align 4
+trace:
+  endbr64
+  cmpl trace_level(%rip), %edi
+trace_br:
+  jg trace_slow
+# FDATA: 1 trace #trace_br# 1 trace #trace_slow# 0 10
+# FDATA: 1 trace #trace_br# 1 trace #trace_ret# 0 990
+trace_ret:
+  retq
+trace_slow:
+  pushq %rbx
+  movl %edi, %ebx
+  callq emit
+  movl %ebx, %eax
+  popq %rbx
+  retq
+  .size trace, .-trace
+
+  .globl pushy
+  .type pushy,@function
+  .p2align 4
+pushy:
+  pushq %rbx
+  movq (%rdi), %rbx
+  testq %rbx, %rbx
+pushy_br:
+  je pushy_slow
+# FDATA: 1 pushy #pushy_br# 1 pushy #pushy_slow# 0 10
+# FDATA: 1 pushy #pushy_br# 1 pushy #pushy_fast# 0 990
+pushy_fast:
+  movq %rbx, %rax
+  popq %rbx
+  retq
+pushy_slow:
+  callq emit
+  movq %rbx, %rax
+  popq %rbx
+  retq
+  .size pushy, .-pushy
+
+  .globl emit
+  .type emit,@function
+  .p2align 4
+emit:
+  retq
+  .size emit, .-emit
+
+  .globl main
+  .type main,@function
+  .p2align 4
+main:
+# FDATA: 0 [unknown] 0 1 main 0 0 1000
+  pushq %rax
+  movl $5, %edi
+main_call1:
+  callq trace
+# FDATA: 1 main #main_call1# 1 trace 0 0 1000
+  leaq slot(%rip), %rdi
+main_call2:
+  callq pushy
+# FDATA: 1 main #main_call2# 1 pushy 0 0 1000
+  xorl %eax, %eax
+  popq %rcx
+  retq
+  .size main, .-main
+
+  .data
+  .globl trace_level
+trace_level:
+  .long 0
+  .globl slot
+  .p2align 3
+slot:
+  .quad 0
diff --git a/bolt/test/runtime/AArch64/partial-inline.c b/bolt/test/runtime/AArch64/partial-inline.c
new file mode 100644
index 000000000..38c989107
--- /dev/null
+++ b/bolt/test/runtime/AArch64/partial-inline.c
@@ -0,0 +1,185 @@
+// Check that partial inlining preserves program behavior end to end: compile
+// at -O2, collect an instrumentation profile, optimize with partial inlining
+// and compare the output with the original binary. The program contains fast
+// paths with and without stack frames, with stores after the fast/slow
+// decision and with callee-saved temporaries, and also callees that must be
+// rejected. Repeat with return address signing and BTI enabled, which on
+// hardware with FEAT_PAuth makes a wrong frame elision fault.
+
+// REQUIRES: system-linux,bolt-runtime
+
+// RUN: %clang %cflags -O2 -fno-inline %s -o %t.exe -Wl,-q
+// RUN: %t.exe 2000000 > %t.ref
+// RUN: llvm-bolt %t.exe --instrument --instrumentation-file=%t.fdata \
+// RUN:   --instrumentation-file-append-pid=0 -o %t.instr
+// RUN: %t.instr 200000 > /dev/null
+// RUN: llvm-bolt %t.exe -o %t.bolt --data %t.fdata --partial-inline -v=1 \
+// RUN:   --reorder-blocks=ext-tsp --split-functions --split-all-cold \
+// RUN:   | FileCheck %s
+// RUN: %t.bolt 2000000 > %t.out
+// RUN: cmp %t.ref %t.out
+
+// RUN: %clang %cflags -O2 -fno-inline -mbranch-protection=standard %s \
+// RUN:   -o %t.pac.exe -Wl,-q
+// RUN: %t.pac.exe 2000000 > %t.pac.ref
+// RUN: llvm-bolt %t.pac.exe --instrument --instrumentation-file=%t.pac.fdata \
+// RUN:   --instrumentation-file-append-pid=0 -o %t.pac.instr
+// RUN: %t.pac.instr 200000 > /dev/null
+// RUN: llvm-bolt %t.pac.exe -o %t.pac.bolt --data %t.pac.fdata \
+// RUN:   --partial-inline -v=1 --reorder-blocks=ext-tsp --split-functions \
+// RUN:   | FileCheck %s
+// RUN: %t.pac.bolt 2000000 > %t.pac.out
+// RUN: cmp %t.pac.ref %t.pac.out
+
+// CHECK-DAG: partial inlining: trace_event into
+// CHECK-DAG: partial inlining: memo_get into
+// CHECK-DAG: partial inlining: buf_putc into
+// CHECK-DAG: partial inlining: pool_free into
+// CHECK-NOT: partial inlining: obj_release into
+// CHECK: BOLT-INFO: partial inlining: {{[0-9]+}} callees with a fast region
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define NOINLINE __attribute__((noinline))
+
+// Frameless fast path.
+int trace_level;
+unsigned long trace_bytes;
+NOINLINE void trace_event(int level, long a) {
+  if (level > trace_level)
+    return;
+  char line[64];
+  int n = snprintf(line, sizeof line, "%d:%ld\n", level, a);
+  trace_bytes += n;
+}
+
+// Callee-saved temporaries on the fast path (typically not shrink-wrapped).
+struct entry {
+  uint64_t key, val;
+};
+static struct entry cache[256];
+uint64_t misses;
+NOINLINE uint64_t expensive(uint64_t k) {
+  for (int i = 0; i < 16; i++)
+    k = (k ^ (k >> 29)) * 0xbf58476d1ce4e5b9ULL;
+  return k;
+}
+NOINLINE uint64_t memo_get(uint64_t key) {
+  struct entry *e = &cache[key & 255];
+  if (e->key == key + 1)
+    return e->val;
+  uint64_t v = expensive(key);
+  e->key = key + 1;
+  e->val = v;
+  misses++;
+  return v;
+}
+
+// Stores on the fast path after the decision.
+struct buf {
+  unsigned char *data;
+  size_t pos, cap;
+  uint64_t hash;
+};
+NOINLINE void flush(struct buf *b) {
+  for (size_t i = 0; i < b->pos; i++)
+    b->hash = (b->hash ^ b->data[i]) * 0x100000001b3ULL;
+  b->pos = 0;
+}
+NOINLINE int buf_putc(struct buf *b, int c) {
+  if (b->pos < b->cap) {
+    b->data[b->pos++] = (unsigned char)c;
+    return c;
+  }
+  flush(b);
+  b->data[b->pos++] = (unsigned char)c;
+  return c;
+}
+
+struct node {
+  struct node *next;
+};
+struct pool {
+  struct node *free;
+  size_t live, slabs;
+};
+NOINLINE void *pool_alloc(struct pool *p) {
+  struct node *n = p->free;
+  if (n) {
+    p->free = n->next;
+    p->live++;
+    return n;
+  }
+  char *slab = malloc(64 * 32);
+  for (int i = 0; i < 32; i++) {
+    struct node *nd = (struct node *)(slab + i * 64);
+    nd->next = p->free;
+    p->free = nd;
+  }
+  p->slabs++;
+  n = p->free;
+  p->free = n->next;
+  p->live++;
+  return n;
+}
+NOINLINE void pool_free(struct pool *p, void *ptr) {
+  struct node *n = ptr;
+  n->next = p->free;
+  p->free = n;
+  p->live--;
+}
+
+// Store before the decision: must be rejected.
+struct obj {
+  long rc;
+  long destroyed;
+};
+NOINLINE void destroy(struct obj *o) {
+  o->destroyed++;
+  o->rc = 100;
+}
+NOINLINE int obj_release(struct obj *o) {
+  if (--o->rc != 0)
+    return 0;
+  destroy(o);
+  return 1;
+}
+
+static uint64_t rng(uint64_t *s) {
+  *s ^= *s << 13;
+  *s ^= *s >> 7;
+  *s ^= *s << 17;
+  return *s;
+}
+
+int main(int argc, char **argv) {
+  long n = argc > 1 ? atol(argv[1]) : 100000;
+  uint64_t s = 42, acc = 0;
+  struct buf b = {malloc(4096), 0, 4096, 1469598103934665603ULL};
+  struct pool p = {0, 0, 0};
+  void *window[64] = {0};
+  struct obj o = {100, 0};
+  for (long i = 0; i < n; i++) {
+    uint64_t r = rng(&s);
+    trace_event(2, (long)r);
+    if ((i & 1023) == 0)
+      trace_event(0, i); // rarely taken slow path
+    acc += memo_get((r & 15) ? (r >> 32) & 63 : r >> 20);
+    acc += buf_putc(&b, 'a' + (int)(r % 26));
+    unsigned slot = (unsigned)(r >> 40) & 63;
+    if (window[slot])
+      pool_free(&p, window[slot]);
+    window[slot] = pool_alloc(&p);
+    acc += obj_release(&o);
+  }
+  flush(&b);
+  printf("acc=%016llx misses=%llu hash=%016llx live=%zu slabs=%zu "
+         "trace=%lu destroyed=%ld\n",
+         (unsigned long long)acc, (unsigned long long)misses,
+         (unsigned long long)b.hash, p.live, p.slabs, trace_bytes,
+         o.destroyed);
+  return 0;
+}
-- 
2.56.0

