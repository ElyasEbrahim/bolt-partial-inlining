+++ b/bolt/include/bolt/Core/MCPlusBuilder.h
@@ -847,6 +847,59 @@ public:
 
   virtual bool isLeave(const MCInst &Inst) const { return false; }
 
+  /// Role of an instruction in setting up or tearing down the stack frame of
+  /// the function that contains it, as computed by analyzeFrameInstruction().
+  struct FrameInstrInfo {
+    enum FrameInstrKind : uint8_t {
+      FIK_None,       ///< Not a recognized frame instruction.
+      FIK_SPAdjust,   ///< SP += SPDelta.
+      FIK_Save,       ///< Store Regs to consecutive stack slots.
+      FIK_Restore,    ///< Load Regs from consecutive stack slots.
+      FIK_FPSetup,    ///< FP = SP + Offset.
+      FIK_SignRA,     ///< Sign the return address register.
+      FIK_AuthRA,     ///< Authenticate the return address register.
+      FIK_LandingPad, ///< Control-flow integrity landing pad (e.g. BTI C).
+    };
+    FrameInstrKind Kind = FIK_None;
+    /// Value added to the stack pointer by the instruction (pre/post-indexed
+    /// addressing modes and explicit adjustments).
+    int64_t SPDelta = 0;
+    /// FIK_Save/FIK_Restore: offset of the first slot relative to the stack
+    /// pointer value before the instruction executes. FIK_FPSetup: offset
+    /// added to the stack pointer to form the frame pointer.
+    int64_t Offset = 0;
+    /// FIK_Save/FIK_Restore: size in bytes of each slot.
+    unsigned SlotSize = 0;
+    /// FIK_Save/FIK_Restore: registers stored to (loaded from) consecutive
+    /// slots starting at Offset.
+    SmallVector<MCPhysReg, 2> Regs;
+  };
+
+  /// Return true if \p Inst only builds or tears down the stack frame of the
+  /// containing function in one of the forms emitted in prologues and
+  /// epilogues, and describe it in \p Info. Only stack-pointer based
+  /// addressing with a constant offset is recognized. Targets that do not
+  /// implement the analysis return false.
+  virtual bool analyzeFrameInstruction(const MCInst &Inst,
+                                       FrameInstrInfo &Info) const {
+    return false;
+  }
+
+  /// Append to \p Regs, in order of preference, registers of the same
+  /// register class and size as \p Reg that are caller-saved and are never
+  /// used for passing arguments or returning values under the platform ABI.
+  /// A callee cannot depend on their values at entry, which makes them usable
+  /// as scratch registers at a call site. Targets that do not implement it
+  /// append nothing.
+  virtual void getCallSiteScratchRegs(MCPhysReg Reg,
+                                      SmallVectorImpl<MCPhysReg> &Regs) const {}
+
+  /// Return the largest register whose value is completely determined when an
+  /// instruction writes \p Reg, e.g. X0 for a write to W0 on AArch64 (the upper
+  /// half is zeroed) or RAX for a write to EAX on x86-64. The default is
+  /// \p Reg itself, which is always correct but may be imprecise.
+  virtual MCPhysReg getFullyDefinedReg(MCPhysReg Reg) const { return Reg; }
+
   virtual bool isADRP(const MCInst &Inst) const {
     llvm_unreachable("not implemented");
     return false;
diff --git a/bolt/include/bolt/Passes/PartialInlining.h b/bolt/include/bolt/Passes/PartialInlining.h
new file mode 100644
index 000000000..29212fc74
--- /dev/null
+++ b/bolt/include/bolt/Passes/PartialInlining.h
@@ -0,0 +1,196 @@
+//===- bolt/Passes/PartialInlining.h - Fast-path partial inlining -*- C++ -*-=//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Profile-guided partial inlining of callee fast paths.
+//
+// Hot functions often begin with a short, frequently taken path that returns
+// early (a cache hit, a buffer with free space, a disabled tracing level, a
+// non-empty free list, ...) followed by a much larger slow path. These
+// functions are too big to be inlined as a whole, and without LTO the
+// compiler cannot inline across translation units at all. In addition, when
+// the fast path shares values with the slow path, the compiler frequently
+// fails to shrink-wrap the function, so every fast-path execution also pays
+// for the full prologue and epilogue.
+//
+// For a hot direct call site of such a function F, this pass copies the
+// profile-hot, acyclic "fast region" of F that starts at its entry and ends
+// in returns into the caller:
+//
+//   * Instructions that only build or tear down F's stack frame (stack
+//     pointer adjustments, callee-saved register spills and reloads, frame
+//     pointer setup, return address signing/authentication, CFI and landing
+//     pads) are not copied ("frame elision").
+//   * Callee-saved registers that the fast path uses as temporaries are
+//     renamed to scratch registers that the call already clobbers.
+//   * Returns become branches to the instruction following the call (or stay
+//     returns at tail-call sites).
+//   * Every edge leaving the region ("slow exit") is redirected to a block
+//     that performs the original call. The copied region is free of memory
+//     side effects on every path to a slow exit and never overwrites a
+//     register before reading it there, so the callee re-executes from its
+//     entry with exactly the architectural state of the original call
+//     ("re-execution fallback"). F itself is not modified.
+//
+//===----------------------------------------------------------------------===//
+
+#ifndef BOLT_PASSES_PARTIALINLINING_H
+#define BOLT_PASSES_PARTIALINLINING_H
+
+#include "bolt/Passes/BinaryPasses.h"
+#include "llvm/ADT/BitVector.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/DenseSet.h"
+#include "llvm/ADT/SmallVector.h"
+#include <memory>
+
+namespace llvm {
+namespace bolt {
+
+class RegAnalysis;
+class BinaryFunctionCallGraph;
+
+class PartialInlining : public BinaryFunctionPass {
+public:
+  /// Why a function could not provide a fast region. Used for statistics.
+  enum RejectReason : unsigned {
+    RR_None = 0,
+    RR_NotSimple,     ///< Not simple, ignored, no CFG or multi-entry.
+    RR_NoProfile,     ///< No valid profile or never executed.
+    RR_EntryNotSafe,  ///< Entry block contains a non-copyable instruction.
+    RR_NoFastExit,    ///< No return reachable through copyable blocks.
+    RR_StackAccess,   ///< Fast path accesses the stack frame or SP/FP/LR.
+    RR_FrameMismatch, ///< Prologue/epilogue could not be matched.
+    RR_SideEffect,    ///< Side effect before the fast/slow decision.
+    RR_RegClobber,    ///< Register overwritten before it is read on a slow
+                      ///< path (re-execution would observe a new value).
+    RR_NoScratch,     ///< Not enough scratch registers for renaming.
+    RR_TooLarge,      ///< Region exceeds size limits even after pruning.
+    RR_ColdFastPath,  ///< Fast path probability below the threshold.
+    RR_Last
+  };
+
+  /// The fast region of a callee together with everything needed to copy it.
+  struct FastRegion {
+    /// Region blocks in a topological order; Blocks.front() is the entry.
+    SmallVector<BinaryBasicBlock *, 8> Blocks;
+    DenseSet<const BinaryBasicBlock *> InRegion;
+    /// Instructions that are not copied (frame setup/teardown, CFI, ...).
+    DenseSet<const MCInst *> Dropped;
+    /// Callee-saved registers that the region uses as temporaries. Each one
+    /// is renamed to a scratch register chosen per call site.
+    SmallVector<MCPhysReg, 4> RenamedRegs;
+    /// For each renamed register, scratch candidates that satisfy all
+    /// callee-side constraints, in order of preference.
+    SmallVector<SmallVector<MCPhysReg, 8>, 4> ScratchCandidates;
+    /// Registers that a call to the callee may clobber.
+    BitVector CalleeClobbers;
+    /// Region flow: estimated number of callee invocations that reach each
+    /// block (and edge) by following region paths from the entry.
+    DenseMap<const BinaryBasicBlock *, double> Flow;
+    /// Probability of leaving the region through a return from each block.
+    DenseMap<const BinaryBasicBlock *, double> PFast;
+    /// Successor edge probabilities of region blocks (in successor order),
+    /// snapshotted before any profile update.
+    DenseMap<const BinaryBasicBlock *, SmallVector<double, 2>> SuccProb;
+    /// Estimated number of callee invocations.
+    double EntryFlow = 0.0;
+    /// Probability that an invocation leaves through a fast exit.
+    double FastProb = 0.0;
+    /// Estimated number of invocations that take a slow exit.
+    double SlowCount = 0.0;
+    /// Number of instructions copied to each call site.
+    unsigned NumCopiedInsts = 0;
+    /// True if prologue/epilogue instructions were elided.
+    bool HasFrame = false;
+  };
+
+  explicit PartialInlining(const cl::opt<bool> &PrintPass)
+      : BinaryFunctionPass(PrintPass) {}
+  ~PartialInlining() override;
+
+  const char *getName() const override { return "partial-inlining"; }
+
+  bool shouldPrint(const BinaryFunction &BF) const override {
+    return BinaryFunctionPass::shouldPrint(BF) && Modified.count(&BF) > 0;
+  }
+
+  Error runOnFunctions(BinaryContext &BC) override;
+
+private:
+  struct CallSite {
+    BinaryFunction *Caller;
+    BinaryBasicBlock *BB;
+    /// Index of the call instruction in BB at analysis time.
+    unsigned InstIdx;
+    BinaryFunction *Callee;
+    uint64_t Count;
+    double FastProb;
+    double Benefit;
+  };
+
+  /// Compute the fast region of \p BF. Returns RR_None on success.
+  RejectReason analyzeCallee(BinaryFunction &BF, FastRegion &Region);
+
+  /// Build the region once for the given set of excluded blocks. If the
+  /// region can be improved by excluding more blocks, they are returned in
+  /// \p Prune and the caller retries.
+  RejectReason buildRegion(BinaryFunction &BF, FastRegion &Region,
+                           const DenseSet<const BinaryBasicBlock *> &Excluded,
+                           SmallVectorImpl<const BinaryBasicBlock *> &Prune);
+
+  using RenameList = SmallVector<std::pair<MCPhysReg, MCPhysReg>, 4>;
+
+  /// Compute callee-side scratch register candidates for the registers in
+  /// \p Region.RenamedRegs.
+  bool computeScratchCandidates(BinaryFunction &BF, FastRegion &Region);
+
+  /// Choose scratch registers for \p Site. A candidate is usable if the call
+  /// already clobbers it, or if it is dead after the call in the caller.
+  bool chooseScratchRegisters(const CallSite &Site, const FastRegion &Region,
+                              RenameList &Renames);
+
+  /// Return true if no code of \p Site.Caller (or, through its exits, of its
+  /// callers) can observe the value of \p Reg after the call at \p Site.
+  bool isDeadAfterCall(const CallSite &Site, MCPhysReg Reg);
+
+  /// Copy the fast region of \p Site.Callee into the caller.
+  bool inlineFastPath(const CallSite &Site, const FastRegion &Region,
+                      const RenameList &Renames);
+
+  /// Remove the fast-path flow handled by the inlined copy from the callee
+  /// profile.
+  void updateCalleeProfile(BinaryFunction &Callee, const FastRegion &Region,
+                           uint64_t CallCount);
+
+  /// Lazily constructed register usage analysis.
+  RegAnalysis &getRegAnalysis(BinaryContext &BC);
+
+  std::unique_ptr<BinaryFunctionCallGraph> CG;
+  std::unique_ptr<RegAnalysis> RA;
+
+  DenseSet<const BinaryFunction *> Modified;
+
+  /// Statistics.
+  uint64_t NumRejected[RR_Last] = {};
+  uint64_t NumCandidates = 0;
+  uint64_t NumFramedCandidates = 0;
+  uint64_t NumInlinedSites = 0;
+  uint64_t NumInlinedFramedSites = 0;
+  uint64_t NumTailCallSites = 0;
+  uint64_t NumRenamedRegs = 0;
+  uint64_t NumSitesNoScratch = 0;
+  uint64_t NumCopiedInsts = 0;
+  double DynFastCalls = 0;
+  double DynSlowCalls = 0;
+  uint64_t TotalDirectCalls = 0;
+};
+
+} // namespace bolt
+} // namespace llvm
+
+#endif
