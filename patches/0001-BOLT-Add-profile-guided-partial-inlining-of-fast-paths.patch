+  bool analyzeFrameInstruction(const MCInst &Inst,
+                               FrameInstrInfo &Info) const override {
+    Info = FrameInstrInfo();
+    auto isSP = [](const MCOperand &Op) {
+      return Op.isReg() && Op.getReg() == AArch64::SP;
+    };
+    // Record a store/load of NumRegs registers, starting at operand FirstReg,
+    // based on SP at operand FirstReg + NumRegs with an immediate offset at the
+    // next operand. Pre-indexed forms update SP before the access, post-indexed
+    // forms after it.
+    enum IndexKind { Offset, PreIndex, PostIndex };
+    auto setSlots = [&](FrameInstrInfo::FrameInstrKind Kind, unsigned FirstReg,
+                        unsigned NumRegs, unsigned Scale, IndexKind Index) {
+      const MCOperand &Base = Inst.getOperand(FirstReg + NumRegs);
+      const MCOperand &Imm = Inst.getOperand(FirstReg + NumRegs + 1);
+      if (!isSP(Base) || !Imm.isImm())
+        return false;
+      const int64_t Disp = Imm.getImm() * Scale;
+      Info.Kind = Kind;
+      Info.SlotSize = 8;
+      for (unsigned I = 0; I < NumRegs; ++I) {
+        const MCOperand &Op = Inst.getOperand(FirstReg + I);
+        if (!Op.isReg())
+          return false;
+        Info.Regs.push_back(Op.getReg());
+      }
+      switch (Index) {
+      case Offset:
+        Info.Offset = Disp;
+        break;
+      case PreIndex:
+        Info.Offset = Disp;
+        Info.SPDelta = Disp;
+        break;
+      case PostIndex:
+        Info.Offset = 0;
+        Info.SPDelta = Disp;
+        break;
+      }
+      return true;
+    };
+
+    switch (Inst.getOpcode()) {
+    default:
+      break;
+    // ADD/SUB SP, SP, #imm{, lsl #12} and ADD FP, SP, #imm{, lsl #12}.
+    case AArch64::ADDXri:
+    case AArch64::SUBXri: {
+      if (!Inst.getOperand(0).isReg() || !isSP(Inst.getOperand(1)) ||
+          !Inst.getOperand(2).isImm() || !Inst.getOperand(3).isImm())
+        return false;
+      int64_t Value = Inst.getOperand(2).getImm()
+                      << AArch64_AM::getShiftValue(Inst.getOperand(3).getImm());
+      if (Inst.getOpcode() == AArch64::SUBXri)
+        Value = -Value;
+      if (Inst.getOperand(0).getReg() == AArch64::SP) {
+        Info.Kind = FrameInstrInfo::FIK_SPAdjust;
+        Info.SPDelta = Value;
+        return true;
+      }
+      if (Inst.getOperand(0).getReg() == AArch64::FP && Value >= 0) {
+        Info.Kind = FrameInstrInfo::FIK_FPSetup;
+        Info.Offset = Value;
+        return true;
+      }
+      return false;
+    }
+    // Callee-saved register spills.
+    case AArch64::STPXi:
+    case AArch64::STPDi:
+      return setSlots(FrameInstrInfo::FIK_Save, 0, 2, 8, Offset);
+    case AArch64::STPXpre:
+    case AArch64::STPDpre:
+      return setSlots(FrameInstrInfo::FIK_Save, 1, 2, 8, PreIndex);
+    case AArch64::STRXui:
+    case AArch64::STRDui:
+      return setSlots(FrameInstrInfo::FIK_Save, 0, 1, 8, Offset);
+    case AArch64::STURXi:
+    case AArch64::STURDi:
+      return setSlots(FrameInstrInfo::FIK_Save, 0, 1, 1, Offset);
+    case AArch64::STRXpre:
+    case AArch64::STRDpre:
+      return setSlots(FrameInstrInfo::FIK_Save, 1, 1, 1, PreIndex);
+    // Callee-saved register reloads.
+    case AArch64::LDPXi:
+    case AArch64::LDPDi:
+      return setSlots(FrameInstrInfo::FIK_Restore, 0, 2, 8, Offset);
+    case AArch64::LDPXpost:
+    case AArch64::LDPDpost:
+      return setSlots(FrameInstrInfo::FIK_Restore, 1, 2, 8, PostIndex);
+    case AArch64::LDRXui:
+    case AArch64::LDRDui:
+      return setSlots(FrameInstrInfo::FIK_Restore, 0, 1, 8, Offset);
+    case AArch64::LDURXi:
+    case AArch64::LDURDi:
+      return setSlots(FrameInstrInfo::FIK_Restore, 0, 1, 1, Offset);
+    case AArch64::LDRXpost:
+    case AArch64::LDRDpost:
+      return setSlots(FrameInstrInfo::FIK_Restore, 1, 1, 1, PostIndex);
+    case AArch64::HINT: {
+      // BTI {c|j|jc} landing pads (HINT #32, #34, #36, #38).
+      if (MCPlus::getNumPrimeOperands(Inst) != 1 || !Inst.getOperand(0).isImm())
+        return false;
+      const int64_t Imm = Inst.getOperand(0).getImm();
+      if (Imm != 32 && Imm != 34 && Imm != 36 && Imm != 38)
+        return false;
+      Info.Kind = FrameInstrInfo::FIK_LandingPad;
+      return true;
+    }
+    }
+
+    // Return address signing and authentication that only use SP as the
+    // modifier (PACIASP, AUTIBSP, ...).
+    if (isPSignOnLR(Inst)) {
+      Info.Kind = FrameInstrInfo::FIK_SignRA;
+      return true;
+    }
+    if (isPAuthOnLR(Inst) && !isReturn(Inst)) {
+      Info.Kind = FrameInstrInfo::FIK_AuthRA;
+      return true;
+    }
+    return false;
+  }
+
+  void getCallSiteScratchRegs(MCPhysReg Reg,
+                              SmallVectorImpl<MCPhysReg> &Regs) const override {
+    // AAPCS64: X9-X15 are temporaries and V16-V31 are caller-saved vector
+    // registers, none of which carries arguments or results. X16/X17 are
+    // excluded since BOLT uses them for long-branch stubs.
+    const MCRegisterClass &GPR64 =
+        RegInfo->getRegClass(AArch64::GPR64RegClassID);
+    const MCRegisterClass &GPR32 =
+        RegInfo->getRegClass(AArch64::GPR32RegClassID);
+    const MCRegisterClass &FPR64 =
+        RegInfo->getRegClass(AArch64::FPR64RegClassID);
+    const MCRegisterClass &FPR128 =
+        RegInfo->getRegClass(AArch64::FPR128RegClassID);
+    static const MCPhysReg XTemps[] = {AArch64::X9,  AArch64::X10, AArch64::X11,
+                                       AArch64::X12, AArch64::X13, AArch64::X14,
+                                       AArch64::X15};
+    static const MCPhysReg WTemps[] = {AArch64::W9,  AArch64::W10, AArch64::W11,
+                                       AArch64::W12, AArch64::W13, AArch64::W14,
+                                       AArch64::W15};
+    static const MCPhysReg DTemps[] = {
+        AArch64::D16, AArch64::D17, AArch64::D18, AArch64::D19,
+        AArch64::D20, AArch64::D21, AArch64::D22, AArch64::D23,
+        AArch64::D24, AArch64::D25, AArch64::D26, AArch64::D27,
+        AArch64::D28, AArch64::D29, AArch64::D30, AArch64::D31};
+    static const MCPhysReg QTemps[] = {
+        AArch64::Q16, AArch64::Q17, AArch64::Q18, AArch64::Q19,
+        AArch64::Q20, AArch64::Q21, AArch64::Q22, AArch64::Q23,
+        AArch64::Q24, AArch64::Q25, AArch64::Q26, AArch64::Q27,
+        AArch64::Q28, AArch64::Q29, AArch64::Q30, AArch64::Q31};
+    if (GPR64.contains(Reg))
+      Regs.append(std::begin(XTemps), std::end(XTemps));
+    else if (GPR32.contains(Reg))
+      Regs.append(std::begin(WTemps), std::end(WTemps));
+    else if (FPR64.contains(Reg))
+      Regs.append(std::begin(DTemps), std::end(DTemps));
+    else if (FPR128.contains(Reg))
+      Regs.append(std::begin(QTemps), std::end(QTemps));
+  }
+
+  MCPhysReg getFullyDefinedReg(MCPhysReg Reg) const override {
+    // Writes to W registers zero the upper half of the X register. Scalar
+    // writes to B/H/S/D registers zero the remaining bits of the Q register.
+    const MCRegisterClass &GPR32 =
+        RegInfo->getRegClass(AArch64::GPR32RegClassID);
+    if (GPR32.contains(Reg) && Reg != AArch64::WZR && Reg != AArch64::WSP) {
+      const MCPhysReg Super = RegInfo->getMatchingSuperReg(
+          Reg, AArch64::sub_32,
+          &RegInfo->getRegClass(AArch64::GPR64RegClassID));
+      return Super ? Super : Reg;
+    }
+    static const std::pair<unsigned, unsigned> FPSubRegs[] = {
+        {AArch64::FPR8RegClassID, AArch64::bsub},
+        {AArch64::FPR16RegClassID, AArch64::hsub},
+        {AArch64::FPR32RegClassID, AArch64::ssub},
+        {AArch64::FPR64RegClassID, AArch64::dsub}};
+    for (const auto &[ClassID, SubIdx] : FPSubRegs) {
+      if (!RegInfo->getRegClass(ClassID).contains(Reg))
+        continue;
+      const MCPhysReg Super = RegInfo->getMatchingSuperReg(
+          Reg, SubIdx, &RegInfo->getRegClass(AArch64::FPR128RegClassID));
+      return Super ? Super : Reg;
+    }
+    return Reg;
+  }
