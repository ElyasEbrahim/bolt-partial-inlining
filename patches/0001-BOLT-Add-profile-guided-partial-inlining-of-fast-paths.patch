+const char *getRejectReasonName(PartialInlining::RejectReason R) {
+  switch (R) {
+  case PartialInlining::RR_None:
+    return "none";
+  case PartialInlining::RR_NotSimple:
+    return "not-simple";
+  case PartialInlining::RR_NoProfile:
+    return "no-profile";
+  case PartialInlining::RR_EntryNotSafe:
+    return "entry-not-copyable";
+  case PartialInlining::RR_NoFastExit:
+    return "no-fast-exit";
+  case PartialInlining::RR_StackAccess:
+    return "stack-access";
+  case PartialInlining::RR_FrameMismatch:
+    return "frame-mismatch";
+  case PartialInlining::RR_SideEffect:
+    return "side-effect";
+  case PartialInlining::RR_RegClobber:
+    return "reg-clobber";
+  case PartialInlining::RR_NoScratch:
+    return "no-scratch";
+  case PartialInlining::RR_TooLarge:
+    return "too-large";
+  case PartialInlining::RR_ColdFastPath:
+    return "cold-fast-path";
+  case PartialInlining::RR_Last:
+    break;
+  }
+  return "unknown";
+}
+
+/// Return the probability of each successor edge of \p BB, in successor order.
+SmallVector<double, 2> getSuccessorProbabilities(const BinaryBasicBlock &BB) {
+  SmallVector<double, 2> Probs;
+  const unsigned NumSuccs = BB.succ_size();
+  if (!NumSuccs)
+    return Probs;
+  uint64_t Total = 0;
+  for (auto BI = BB.branch_info_begin(); BI != BB.branch_info_end(); ++BI)
+    if (BI->Count != BinaryBasicBlock::COUNT_NO_PROFILE)
+      Total += BI->Count;
+  for (auto BI = BB.branch_info_begin(); BI != BB.branch_info_end(); ++BI) {
+    if (!Total)
+      Probs.push_back(1.0 / NumSuccs);
+    else if (BI->Count == BinaryBasicBlock::COUNT_NO_PROFILE)
+      Probs.push_back(0.0);
+    else
+      Probs.push_back(static_cast<double>(BI->Count) / Total);
+  }
+  return Probs;
+}
+
+/// Set of registers that overlap any register in \p Regs.
+BitVector getAliasClosure(const BinaryContext &BC, const BitVector &Regs) {
+  BitVector Result(Regs.size(), false);
+  for (int R = Regs.find_first(); R != -1; R = Regs.find_next(R))
+    Result |= BC.MIB->getAliases(R, /*OnlySmaller=*/false);
+  return Result;
+}
+
+/// Storage of the architectural register containing \p Reg: the register
+/// written in full when \p Reg is written, and all of its sub-registers. Unlike
+/// the full alias set it does not include super-register tuples (e.g. the
+/// X8_X9 pair on AArch64), which would make unrelated registers conflict.
+const BitVector &getRegStorage(const BinaryContext &BC, MCPhysReg Reg) {
+  return BC.MIB->getAliases(BC.MIB->getFullyDefinedReg(Reg),
+                            /*OnlySmaller=*/true);
+}
+
+/// Registers completely defined by \p Inst: the OnlySmaller alias closure of
+/// the fully defined register (see MCPlusBuilder::getFullyDefinedReg) of every
+/// explicit and implicit definition.
+BitVector getFullyDefinedRegs(const BinaryContext &BC, const MCInst &Inst) {
+  const MCPlusBuilder &MIB = *BC.MIB;
+  BitVector Regs(BC.MRI->getNumRegs(), false);
+  const MCInstrDesc &Desc = BC.MII->get(Inst.getOpcode());
+  for (MCPhysReg R : Desc.implicit_defs())
+    Regs |= MIB.getAliases(MIB.getFullyDefinedReg(R), /*OnlySmaller=*/true);
+  for (const MCOperand &Op : MIB.defOperands(Inst))
+    if (Op.isReg() && Op.getReg())
+      Regs |= MIB.getAliases(MIB.getFullyDefinedReg(Op.getReg()),
+                             /*OnlySmaller=*/true);
+  return Regs;
+}
+
+/// Rename every occurrence of \p From (or one of its sub-registers) in \p Inst
+/// to the corresponding (sub-)register of \p To. Return false, leaving \p Inst
+/// in an unspecified state, if an operand references a super-register or a
+/// partially overlapping register of \p From, or if \p From overlaps an
+/// implicit operand.
+bool renameRegister(const BinaryContext &BC, MCInst &Inst, MCPhysReg From,
+                    MCPhysReg To) {
+  const MCRegisterInfo &MRI = *BC.MRI;
+  const MCInstrDesc &Desc = BC.MII->get(Inst.getOpcode());
+  for (MCPhysReg R : Desc.implicit_defs())
+    if (MRI.regsOverlap(R, From))
+      return false;
+  for (MCPhysReg R : Desc.implicit_uses())
+    if (MRI.regsOverlap(R, From))
+      return false;
+
+  for (MCOperand &Op : MCPlus::primeOperands(Inst)) {
+    if (!Op.isReg() || !Op.getReg())
+      continue;
+    const MCRegister Reg = Op.getReg();
+    if (!MRI.regsOverlap(Reg, From))
+      continue;
+    if (Reg == From) {
+      Op.setReg(To);
+      continue;
+    }
+    if (!MRI.isSubRegister(From, Reg))
+      return false;
+    const unsigned Idx = MRI.getSubRegIndex(From, Reg);
+    const MCRegister NewReg = Idx ? MRI.getSubReg(To, Idx) : MCRegister();
+    if (!NewReg)
+      return false;
+    Op.setReg(NewReg);
+  }
+  return true;
+}
+
+/// Return true if the instruction may be copied into another function without
+/// changing its meaning, ignoring the frame/register constraints that are
+/// checked separately. Branches must target blocks of \p BF.
+bool isCopyableInstruction(const BinaryContext &BC, const BinaryFunction &BF,
+                           const MCInst &Inst) {
+  const MCPlusBuilder &MIB = *BC.MIB;
+  if (MIB.isCFI(Inst))
+    return true;
+  // EH labels, SDT markers and other pseudo instructions.
+  if (MIB.isPseudo(Inst))
+    return false;
+  // Calls, tail calls and conditional tail calls.
+  if (MIB.isCall(Inst))
+    return false;
+  if (MIB.isIndirectBranch(Inst) || MIB.isUnsupportedInstruction(Inst) ||
+      MIB.getJumpTable(Inst))
+    return false;
+  if (MIB.isReturn(Inst))
+    return !BC.isX86() || MCPlus::getNumPrimeOperands(Inst) == 0;
+  if (MIB.isBranch(Inst)) {
+    const MCSymbol *Target = MIB.getTargetSymbol(Inst);
+    return Target && BF.getBasicBlockForLabel(Target);
+  }
+  // Symbolic operands must not reference code or data owned by the callee
+  // (local labels, secondary entries, jump tables).
+  for (const MCOperand &Op : MCPlus::primeOperands(Inst)) {
+    if (!Op.isExpr())
+      continue;
+    const MCSymbol *Sym = MIB.getTargetSymbol(Op.getExpr());
+    if (!Sym) {
+      if (!isa<MCConstantExpr>(Op.getExpr()))
+        return false;
+      continue;
+    }
+    if (BF.getBasicBlockForLabel(Sym))
+      return false;
+    uint64_t EntryID = 0;
+    if (BC.getFunctionForSymbol(Sym, &EntryID) == &BF && EntryID != 0)
+      return false;
+    if (const BinaryData *BD = BC.getBinaryDataByName(Sym->getName()))
+      if (const_cast<BinaryContext &>(BC).getJumpTableContainingAddress(
+              BD->getAddress()))
+        return false;
+  }
+  return true;
+}
+
+/// Frame and dataflow state at a program point of the region.
+struct RegionState {
+  bool Valid = false;
+  /// Stack pointer relative to its value at the callee entry.
+  int64_t SPOffset = 0;
+  /// Stack slot (relative to the entry SP) -> register whose entry value is
+  /// stored there.
+  std::map<int64_t, MCPhysReg> Slots;
+  /// Registers whose entry value has been saved to a slot.
+  BitVector Saved;
+  /// Saved registers modified by the body and not restored yet on some
+  /// (Dirty) or on every (MustDirty) region path to this point.
+  BitVector Dirty;
+  BitVector MustDirty;
+  /// Registers written by body instructions so far (OnlySmaller closure).
+  BitVector Written;
+  /// Registers that are defined on every region path to this point.
+  BitVector MustDef;
+  bool FPModified = false;
+  bool RASigned = false;
+
+  bool frameEquals(const RegionState &O) const {
+    return SPOffset == O.SPOffset && Slots == O.Slots && Saved == O.Saved &&
+           FPModified == O.FPModified && RASigned == O.RASigned;
+  }
+};
+
+/// Does \p BF read \p Reg before writing it on some path from its entry?
+/// Calls are assumed to read only argument registers (\p Reg is never one).
+bool isUpwardExposed(const BinaryContext &BC, const BinaryFunction &BF,
+                     MCPhysReg Reg) {
+  const MCPlusBuilder &MIB = *BC.MIB;
+  const BitVector &Aliases = MIB.getAliases(Reg, /*OnlySmaller=*/false);
+  enum Effect { Transparent, Reads, Kills };
+  auto getEffect = [&](const BinaryBasicBlock &BB) {
+    for (const MCInst &Inst : BB) {
+      if (MIB.isPseudo(Inst))
+        continue;
+      BitVector Used(BC.MRI->getNumRegs(), false);
+      MIB.getUsedRegs(Inst, Used);
+      if (Used.anyCommon(Aliases))
+        return Reads;
+      if (MIB.isCall(Inst) || getFullyDefinedRegs(BC, Inst).test(Reg))
+        return Kills;
+    }
+    return Transparent;
+  };
+  SmallVector<const BinaryBasicBlock *, 16> Worklist;
+  DenseSet<const BinaryBasicBlock *> Visited;
+  Worklist.push_back(&BF.front());
+  for (const BinaryBasicBlock *BB : BF.getLayout().blocks())
+    if (BB->isEntryPoint() || BB->isLandingPad())
+      Worklist.push_back(BB);
+  while (!Worklist.empty()) {
+    const BinaryBasicBlock *BB = Worklist.pop_back_val();
+    if (!Visited.insert(BB).second)
+      continue;
+    switch (getEffect(*BB)) {
+    case Reads:
+      return true;
+    case Kills:
+      continue;
+    case Transparent:
+      for (const BinaryBasicBlock *Succ : BB->successors())
+        Worklist.push_back(Succ);
+      for (const BinaryBasicBlock *LP : BB->landing_pads())
+        Worklist.push_back(LP);
+      break;
+    }
+  }
+  return false;
+}
